<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MarketSentimentFinal.Views.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:MarketSentimentFinal.ViewModels"
    x:DataType="vm:MainPageViewModel"
    NavigationPage.HasNavigationBar="False">

    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Offset="0.0" Color="#0F2027" />
            <GradientStop Offset="0.5" Color="#203A43" />
            <GradientStop Offset="1.0" Color="#2C5364" />
        </LinearGradientBrush>
    </ContentPage.Background>

    <Grid RowDefinitions="Auto, *">

        <Border
            Grid.Row="0"
            Padding="20"
            BackgroundColor="#22FFFFFF"
            StrokeShape="RoundRectangle 0,0,15,15"
            StrokeThickness="0">
            <Grid ColumnDefinitions="*, Auto, Auto">
                <VerticalStackLayout Grid.Column="0" Spacing="2">
                    <Label
                        FontAttributes="Bold"
                        FontSize="18"
                        Text="{Binding WelcomeText}"
                        TextColor="White" />
                    <Label
                        FontSize="12"
                        Text="Market Insights"
                        TextColor="#BBFFFFFF" />
                </VerticalStackLayout>
                <Button
                    Grid.Column="1"
                    Margin="0,0,10,0"
                    BackgroundColor="#FF5252"
                    Command="{Binding LogoutCommand}"
                    CornerRadius="20"
                    FontFamily="MaterialIcons"
                    FontSize="18"
                    HeightRequest="40"
                    Text="&#xe9ba;"
                    WidthRequest="40" />
                <Button
                    Grid.Column="2"
                    BackgroundColor="#00B4DB"
                    Command="{Binding GoToAccountCommand}"
                    CornerRadius="20"
                    FontFamily="MaterialIcons"
                    FontSize="18"
                    HeightRequest="40"
                    Text="&#xe7fd;"
                    WidthRequest="40" />
            </Grid>
        </Border>

        <RefreshView
            Grid.Row="1"
            Command="{Binding RefreshNewsCommand}"
            IsRefreshing="{Binding IsBusy}">
            <CollectionView Margin="15" ItemsSource="{Binding NewsItems}">
                <CollectionView.Header>
                    <Label
                        Margin="0,10,0,15"
                        FontAttributes="Bold"
                        FontSize="22"
                        Text="Latest Crypto News"
                        TextColor="White" />
                </CollectionView.Header>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border
                            Margin="0,0,0,15"
                            Padding="0"
                            BackgroundColor="#1AFFFFFF"
                            Stroke="#33FFFFFF"
                            StrokeShape="RoundRectangle 12">
                            <Grid ColumnDefinitions="*" RowDefinitions="Auto, Auto">
                                <Image
                                    Grid.Row="0"
                                    Aspect="AspectFill"
                                    HeightRequest="150"
                                    Source="{Binding ImageUrl}" />
                                <VerticalStackLayout
                                    Grid.Row="1"
                                    Padding="12"
                                    Spacing="5">
                                    <Label
                                        FontAttributes="Bold"
                                        FontSize="16"
                                        MaxLines="2"
                                        Text="{Binding Title}"
                                        TextColor="White" />
                                    <Label
                                        FontSize="13"
                                        MaxLines="3"
                                        Text="{Binding Description}"
                                        TextColor="#CCFFFFFF" />
                                    <Grid Margin="0,5,0,0" ColumnDefinitions="*, Auto">
                                        <Label
                                            Grid.Column="0"
                                            FontAttributes="Bold"
                                            FontSize="11"
                                            Text="{Binding Source}"
                                            TextColor="#00B4DB" />
                                        <Label
                                            Grid.Column="1"
                                            FontSize="11"
                                            Text="{Binding PublishedAt}"
                                            TextColor="Gray" />
                                    </Grid>
                                </VerticalStackLayout>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>