<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MarketSentimentFinal.Views.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Market Dashboard"
    BackgroundColor="#121212">

    <VerticalStackLayout
        Padding="30"
        Spacing="20"
        VerticalOptions="Center">

        <Label
            FontAttributes="Bold"
            FontSize="28"
            HorizontalOptions="Center"
            Text="Market Sentiment Dashboard"
            TextColor="#512BD4" />

        <Label
            FontSize="16"
            HorizontalOptions="Center"
            Text="Welcome back! Real-time crypto data will appear here."
            TextColor="Gray" />

        <ActivityIndicator IsRunning="True" Color="#512BD4" />

    </VerticalStackLayout>
</ContentPage>