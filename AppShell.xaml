<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="MarketSentimentFinal.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:news="clr-namespace:MarketSentimentFinal.Views.News"
    xmlns:views="clr-namespace:MarketSentimentFinal.Views"
    xmlns:vm="clr-namespace:MarketSentimentFinal.ViewModels"
    x:DataType="vm:AppShellViewModel"
    Shell.NavBarIsVisible="False"
    Shell.TabBarIsVisible="False">

    <Shell.Resources>
        <Style ApplyToDerivedTypes="True" TargetType="Shell">
            <Setter Property="Shell.BackgroundColor" Value="#05070A" />
        </Style>
    </Shell.Resources>

    <TabBar Route="MainSection">
        <ShellContent
            ContentTemplate="{DataTemplate views:MainPage}"
            Route="MainPage"
            Shell.PresentationMode="Animated" />
        <ShellContent
            ContentTemplate="{DataTemplate news:ViewNewsPage}"
            Route="ViewNewsPage"
            Shell.PresentationMode="Animated" />
        <ShellContent
            ContentTemplate="{DataTemplate views:UserDetailsPage}"
            Route="UserDetailsPage"
            Shell.PresentationMode="Animated" />
        <ShellContent
            ContentTemplate="{DataTemplate views:AdminPage}"
            Route="AdminPage"
            Shell.PresentationMode="Animated" />
        <ShellContent
            ContentTemplate="{DataTemplate views:UsersListPage}"
            Route="UsersListPage"
            Shell.PresentationMode="Animated" />
    </TabBar>

    <FlyoutItem FlyoutItemIsVisible="False" Route="LoginSection">
        <ShellContent ContentTemplate="{DataTemplate views:LoginPage}" Route="LoginPage" />
    </FlyoutItem>

</Shell>