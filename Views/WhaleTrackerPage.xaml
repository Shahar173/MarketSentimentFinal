<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MarketSentimentFinal.Views.WhaleTrackerPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:components="clr-namespace:MarketSentimentFinal.Views.Components"
    xmlns:converters="clr-namespace:MarketSentimentFinal.Converters"
    xmlns:models="clr-namespace:MarketSentimentFinal.Models"
    xmlns:vm="clr-namespace:MarketSentimentFinal.ViewModels"
    Title="Whale Tracker"
    x:DataType="vm:WhaleTrackerViewModel"
    Shell.NavBarIsVisible="False">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:BuySellColorConverter x:Key="BuySellColorConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid BackgroundColor="#05070A">
        <!--  אפקט גרדיאנט רקע עליון (ימין)  -->
        <BoxView
            CornerRadius="200"
            HeightRequest="400"
            HorizontalOptions="End"
            TranslationX="150"
            TranslationY="-150"
            VerticalOptions="Start"
            WidthRequest="400">
            <BoxView.Background>
                <RadialGradientBrush>
                    <GradientStop Offset="0.0" Color="#1E3A8A" />
                    <GradientStop Offset="1.0" Color="Transparent" />
                </RadialGradientBrush>
            </BoxView.Background>
        </BoxView>

        <!--  אפקט גרדיאנט רקע תחתון (שמאל)  -->
        <BoxView
            CornerRadius="200"
            HeightRequest="400"
            HorizontalOptions="Start"
            TranslationX="-150"
            TranslationY="150"
            VerticalOptions="End"
            WidthRequest="400">
            <BoxView.Background>
                <RadialGradientBrush>
                    <GradientStop Offset="0.0" Color="#1E3A8A" />
                    <GradientStop Offset="1.0" Color="Transparent" />
                </RadialGradientBrush>
            </BoxView.Background>
        </BoxView>

        <!--  תוקן: צמצום ל-2 שורות והורדת ה-Padding העליון ל-5 כדי להעלות את הכל למעלה  -->
        <Grid Padding="20,5,20,0" RowDefinitions="*, Auto">

            <!--  תוכן מרכזי נגלל (הועבר לשורה 0)  -->
            <RefreshView
                Grid.Row="0"
                Command="{Binding RefreshCommand}"
                IsRefreshing="{Binding IsLoading}"
                RefreshColor="#1E3A8A">
                <ScrollView>
                    <!--  תוקן: Padding עליון שונה ל-0 כדי להצמיד את הבלוק לחלק העליון של המסך  -->
                    <VerticalStackLayout Padding="0,0,0,20" Spacing="20">

                        <!--  כותרת ומד סנטימנט  -->
                        <VerticalStackLayout
                            Margin="0,5"
                            HorizontalOptions="Center"
                            Spacing="6">
                            <Label
                                CharacterSpacing="1.5"
                                FontAttributes="Bold"
                                FontSize="11"
                                HorizontalOptions="Center"
                                Text="WHALE SENTIMENT"
                                TextColor="#64748B" />
                            <Label
                                FontAttributes="Bold"
                                FontSize="56"
                                HorizontalOptions="Center"
                                Text="{Binding SentimentScore}"
                                TextColor="White" />
                            <Label
                                FontAttributes="Bold"
                                FontSize="14"
                                HorizontalOptions="Center"
                                Text="{Binding SentimentStatusText}"
                                TextColor="#00E676" />
                        </VerticalStackLayout>

                        <!--  סקאלת מחוון פרופורציונלית חסינת באגים  -->
                        <VerticalStackLayout
                            HorizontalOptions="Center"
                            Spacing="6"
                            WidthRequest="300">
                            <Grid
                                HeightRequest="14"
                                HorizontalOptions="Center"
                                WidthRequest="300">
                                <BoxView
                                    CornerRadius="3"
                                    HeightRequest="6"
                                    HorizontalOptions="Fill"
                                    VerticalOptions="Center">
                                    <BoxView.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Offset="0.0" Color="#EF4444" />
                                            <GradientStop Offset="0.5" Color="#EAB308" />
                                            <GradientStop Offset="1.0" Color="#00E676" />
                                        </LinearGradientBrush>
                                    </BoxView.Background>
                                </BoxView>

                                <Ellipse
                                    Fill="White"
                                    HeightRequest="12"
                                    HorizontalOptions="Start"
                                    TranslationX="{Binding IndicatorPosition}"
                                    VerticalOptions="Center"
                                    WidthRequest="12" />
                            </Grid>
                            <Grid ColumnDefinitions="Auto, *, Auto" HorizontalOptions="Fill">
                                <Label
                                    Grid.Column="0"
                                    FontSize="10"
                                    Text="HEAVY SELL"
                                    TextColor="#64748B" />
                                <Label
                                    Grid.Column="1"
                                    FontSize="10"
                                    HorizontalOptions="Center"
                                    Text="NEUTRAL"
                                    TextColor="#64748B" />
                                <Label
                                    Grid.Column="2"
                                    FontSize="10"
                                    Text="HEAVY BUY"
                                    TextColor="#64748B" />
                            </Grid>
                        </VerticalStackLayout>

                        <!--  כרטיסי נפח קניות / מכירות  -->
                        <VerticalStackLayout Spacing="8">
                            <Grid ColumnDefinitions="*, *" ColumnSpacing="10">
                                <Border
                                    Grid.Column="0"
                                    Padding="15,12"
                                    BackgroundColor="#0F172A"
                                    Stroke="#15FFFFFF"
                                    StrokeShape="RoundRectangle 10">
                                    <VerticalStackLayout Spacing="4">
                                        <Label
                                            FontSize="10"
                                            Text="BUY VOLUME"
                                            TextColor="#64748B" />
                                        <Label
                                            FontAttributes="Bold"
                                            FontSize="18"
                                            Text="{Binding BuyVolumeText}"
                                            TextColor="#00E676" />
                                        <Label
                                            FontSize="10"
                                            Text="{Binding BuyTxnsCount, StringFormat='{0} txns'}"
                                            TextColor="#64748B" />
                                    </VerticalStackLayout>
                                </Border>

                                <Border
                                    Grid.Column="1"
                                    Padding="15,12"
                                    BackgroundColor="#0F172A"
                                    Stroke="#15FFFFFF"
                                    StrokeShape="RoundRectangle 10">
                                    <VerticalStackLayout Spacing="4">
                                        <Label
                                            FontSize="10"
                                            Text="SELL VOLUME"
                                            TextColor="#64748B" />
                                        <Label
                                            FontAttributes="Bold"
                                            FontSize="18"
                                            Text="{Binding SellVolumeText}"
                                            TextColor="#EF4444" />
                                        <Label
                                            FontSize="10"
                                            Text="{Binding SellTxnsCount, StringFormat='{0} txns'}"
                                            TextColor="#64748B" />
                                    </VerticalStackLayout>
                                </Border>
                            </Grid>

                            <!--  קו יחס פרוגרס מפוצל  -->
                            <VerticalStackLayout Margin="2,2,2,0" Spacing="4">
                                <Grid HeightRequest="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="{Binding BuyProgressBarRatio, StringFormat='{0}*'}" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <BoxView
                                        Grid.Column="0"
                                        CornerRadius="2,0,0,2"
                                        Color="#00E676" />
                                    <BoxView
                                        Grid.Column="1"
                                        CornerRadius="0,2,2,0"
                                        Color="#EF4444" />
                                </Grid>
                                <Grid ColumnDefinitions="*, *">
                                    <Label
                                        Grid.Column="0"
                                        FontSize="10"
                                        Text="{Binding BuyPercentText}"
                                        TextColor="#64748B" />
                                    <Label
                                        Grid.Column="1"
                                        FontSize="10"
                                        HorizontalOptions="End"
                                        Text="{Binding SellPercentText}"
                                        TextColor="#64748B" />
                                </Grid>
                            </VerticalStackLayout>
                        </VerticalStackLayout>

                        <!--  רשימת ההעברות היומית  -->
                        <Label
                            Margin="2,10,0,0"
                            CharacterSpacing="0.5"
                            FontAttributes="Bold"
                            FontSize="12"
                            Text="TODAY"
                            TextColor="#64748B" />

                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Transactions}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="models:WhaleTransaction">
                                    <Border
                                        Margin="0,0,0,10"
                                        Padding="14,12"
                                        BackgroundColor="#0F172A"
                                        Stroke="#10FFFFFF"
                                        StrokeShape="RoundRectangle 12">
                                        <VerticalStackLayout Spacing="8">

                                            <Grid ColumnDefinitions="*, Auto">
                                                <HorizontalStackLayout
                                                    Grid.Column="0"
                                                    Spacing="6"
                                                    VerticalOptions="Center">
                                                    <Label
                                                        FontAttributes="Bold"
                                                        FontSize="15"
                                                        Text="{Binding AmountText}"
                                                        TextColor="White" />
                                                    <Label
                                                        FontAttributes="Bold"
                                                        FontSize="15"
                                                        Text="{Binding Coin}"
                                                        TextColor="#EAB308" />
                                                </HorizontalStackLayout>
                                                <Border
                                                    Grid.Column="1"
                                                    Padding="8,4"
                                                    BackgroundColor="#15FFFFFF"
                                                    StrokeShape="RoundRectangle 6"
                                                    StrokeThickness="0">

                                                    <Label
                                                        FontAttributes="Bold"
                                                        FontSize="9"
                                                        Text="{Binding DisplayType}"
                                                        TextColor="{Binding DisplayType, Converter={StaticResource BuySellColorConverter}}" />
                                                </Border>
                                            </Grid>

                                            <Label
                                                FontAttributes="Bold"
                                                FontSize="18"
                                                Text="{Binding AmountUSD, StringFormat='${0:N3}'}"
                                                TextColor="White" />

                                            <HorizontalStackLayout Margin="0,2" Spacing="6">
                                                <Border
                                                    Padding="8,3"
                                                    BackgroundColor="#08FFFFFF"
                                                    StrokeShape="RoundRectangle 6"
                                                    StrokeThickness="0">
                                                    <Label
                                                        FontSize="10"
                                                        Text="{Binding FromAddress}"
                                                        TextColor="#94A3B8" />
                                                </Border>
                                                <Label
                                                    FontSize="10"
                                                    Text="➔"
                                                    TextColor="#1E3A8A"
                                                    VerticalOptions="Center" />
                                                <Border
                                                    Padding="8,3"
                                                    BackgroundColor="#08FFFFFF"
                                                    StrokeShape="RoundRectangle 6"
                                                    StrokeThickness="0">
                                                    <Label
                                                        FontSize="10"
                                                        Text="{Binding ToAddress}"
                                                        TextColor="#94A3B8" />
                                                </Border>
                                            </HorizontalStackLayout>

                                            <HorizontalStackLayout Margin="2,2,0,0" Spacing="4">
                                                <Label
                                                    FontSize="11"
                                                    Text="🕒"
                                                    TextColor="#64748B" />
                                                <Label
                                                    FontSize="11"
                                                    Text="{Binding TimeAgo}"
                                                    TextColor="#64748B" />
                                            </HorizontalStackLayout>

                                        </VerticalStackLayout>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>

                    </VerticalStackLayout>
                </ScrollView>
            </RefreshView>

            <!--  ה-NavBar בתחתית המסך (הועבר לשורה 1)  -->
            <components:FloatingNavBar
                Grid.Row="1"
                Margin="0,0,0,10"
                ActivePage="Whales"
                VerticalOptions="End" />
        </Grid>
    </Grid>
</ContentPage>