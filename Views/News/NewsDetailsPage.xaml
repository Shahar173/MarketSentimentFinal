<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MarketSentimentFinal.Views.News.NewsDetailsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:MarketSentimentFinal.ViewModels.News"
    Title="Article Details"
    x:DataType="vm:NewsDetailsViewModel"
    Shell.NavBarIsVisible="False">

    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Offset="0.0" Color="#0F2027" />
            <GradientStop Offset="0.5" Color="#203A43" />
            <GradientStop Offset="1.0" Color="#2C5364" />
        </LinearGradientBrush>
    </ContentPage.Background>

    <Grid RowDefinitions="Auto, *">
        <Grid
            Grid.Row="0"
            Padding="20,15,20,5"
            ColumnDefinitions="*, Auto, *">
            <Button
                Grid.Column="0"
                Padding="15,0"
                BackgroundColor="#1F353D"
                Command="{Binding GoBackCommand}"
                CornerRadius="8"
                FontAttributes="Bold"
                HeightRequest="40"
                HorizontalOptions="Start"
                Text="⬅ Back"
                TextColor="White" />

            <Label
                Grid.Column="1"
                CharacterSpacing="1"
                FontAttributes="Bold"
                FontSize="16"
                HorizontalOptions="Center"
                Text="ARTICLE DETAILS"
                TextColor="White"
                VerticalOptions="Center" />
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20,15,20,30" Spacing="20">
                <Border
                    Padding="12,6"
                    BackgroundColor="{Binding Article.SentimentColor}"
                    HorizontalOptions="Start"
                    StrokeShape="RoundRectangle 8"
                    StrokeThickness="0">
                    <Label
                        FontAttributes="Bold"
                        FontSize="11"
                        Text="{Binding Article.Sentiment}"
                        TextColor="White" />
                </Border>

                <Label
                    FontAttributes="Bold"
                    FontSize="24"
                    LineHeight="1.2"
                    Text="{Binding Article.Title}"
                    TextColor="White" />

                <HorizontalStackLayout Spacing="10">
                    <Label
                        FontAttributes="Bold"
                        FontSize="12"
                        Text="{Binding Article.Source}"
                        TextColor="#B0BEC5" />
                    <Label
                        FontSize="12"
                        Text="•"
                        TextColor="#78909C" />
                    <Label
                        FontSize="12"
                        Text="{Binding Article.PublishedAt}"
                        TextColor="#B0BEC5" />
                </HorizontalStackLayout>

                <BoxView
                    Margin="0,5"
                    HeightRequest="1"
                    Color="#334E58" />
                <Label
                    FontSize="16"
                    LineHeight="1.5"
                    Text="{Binding Article.Description}"
                    TextColor="#CFD8DC" />

                <Button
                    Margin="0,20,0,0"
                    BackgroundColor="#00B4DB"
                    Command="{Binding OpenArticleCommand}"
                    CornerRadius="12"
                    FontAttributes="Bold"
                    FontSize="16"
                    HeightRequest="55"
                    Text="🌐 Read Full Article"
                    TextColor="White" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>