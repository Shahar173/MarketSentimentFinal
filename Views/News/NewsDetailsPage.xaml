<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MarketSentimentFinal.Views.News.NewsDetailsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:MarketSentimentFinal.ViewModels.News"
    Title="Article Details"
    x:DataType="vm:NewsDetailsViewModel"
    Shell.NavBarIsVisible="False">

    <Grid BackgroundColor="#05070A">
        <BoxView
            CornerRadius="200"
            HeightRequest="400"
            HorizontalOptions="End"
            TranslationX="150"
            TranslationY="-150"
            VerticalOptions="Start"
            WidthRequest="400">
            <BoxView.Background>
                <RadialGradientBrush>
                    <GradientStop Offset="0.0" Color="#1E3A8A" />
                    <GradientStop Offset="1.0" Color="Transparent" />
                </RadialGradientBrush>
            </BoxView.Background>
        </BoxView>

        <BoxView
            CornerRadius="200"
            HeightRequest="400"
            HorizontalOptions="Start"
            TranslationX="-150"
            TranslationY="150"
            VerticalOptions="End"
            WidthRequest="400">
            <BoxView.Background>
                <RadialGradientBrush>
                    <GradientStop Offset="0.0" Color="#1E3A8A" />
                    <GradientStop Offset="1.0" Color="Transparent" />
                </RadialGradientBrush>
            </BoxView.Background>
        </BoxView>

        <Grid RowDefinitions="Auto, *">
            <Grid
                Grid.Row="0"
                Padding="20,15,20,5"
                ColumnDefinitions="*, Auto, *">
                <Button
                    Grid.Column="0"
                    Padding="15,0"
                    BackgroundColor="#1E3A8A"
                    Command="{Binding GoBackCommand}"
                    CornerRadius="8"
                    FontAttributes="Bold"
                    HeightRequest="40"
                    HorizontalOptions="Start"
                    Text="⬅ Back"
                    TextColor="White" />

                <Label
                    Grid.Column="1"
                    CharacterSpacing="1"
                    FontAttributes="Bold"
                    FontSize="16"
                    HorizontalOptions="Center"
                    Text="ARTICLE DETAILS"
                    TextColor="White"
                    VerticalOptions="Center" />
            </Grid>

            <ScrollView Grid.Row="1">
                <VerticalStackLayout Padding="20,15,20,30" Spacing="20">
                    <Border
                        Padding="12,6"
                        BackgroundColor="{Binding Article.SentimentColor}"
                        HorizontalOptions="Start"
                        StrokeShape="RoundRectangle 8"
                        StrokeThickness="0">
                        <Label
                            FontAttributes="Bold"
                            FontSize="11"
                            Text="{Binding Article.Sentiment}"
                            TextColor="White" />
                    </Border>

                    <Label
                        FontAttributes="Bold"
                        FontSize="24"
                        LineHeight="1.2"
                        Text="{Binding Article.Title}"
                        TextColor="White" />

                    <HorizontalStackLayout Spacing="10">
                        <Label
                            FontAttributes="Bold"
                            FontSize="12"
                            Text="{Binding Article.Source}"
                            TextColor="#94A3B8" />
                        <Label
                            FontSize="12"
                            Text="•"
                            TextColor="#64748B" />
                        <Label
                            FontSize="12"
                            Text="{Binding Article.PublishedAt}"
                            TextColor="#94A3B8" />
                    </HorizontalStackLayout>

                    <BoxView
                        Margin="0,5"
                        HeightRequest="1"
                        Color="#1E3A8A" />

                    <Label
                        FontSize="16"
                        LineHeight="1.5"
                        Text="{Binding Article.Description}"
                        TextColor="#94A3B8" />

                    <Button
                        Margin="0,20,0,0"
                        BackgroundColor="#1E3A8A"
                        Command="{Binding OpenArticleCommand}"
                        CornerRadius="12"
                        FontAttributes="Bold"
                        FontSize="16"
                        HeightRequest="55"
                        Text="🌐 Read Full Article"
                        TextColor="White" />
                </VerticalStackLayout>
            </ScrollView>
        </Grid>
    </Grid>
</ContentPage>