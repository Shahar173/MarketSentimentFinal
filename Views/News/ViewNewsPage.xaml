<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MarketSentimentFinal.Views.News.ViewNewsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:components="clr-namespace:MarketSentimentFinal.Views.Components"
    xmlns:models="clr-namespace:MarketSentimentFinal.Models"
    xmlns:vm="clr-namespace:MarketSentimentFinal.ViewModels.News"
    Title="Live Crypto News"
    x:DataType="vm:ViewNewsViewModel"
    Shell.NavBarIsVisible="False">

    <Grid BackgroundColor="#05070A">
        <!--  אפקט גרדיאנט רקע עליון  -->
        <BoxView
            CornerRadius="200"
            HeightRequest="400"
            HorizontalOptions="End"
            TranslationX="150"
            TranslationY="-150"
            VerticalOptions="Start"
            WidthRequest="400">
            <BoxView.Background>
                <RadialGradientBrush>
                    <GradientStop Offset="0.0" Color="#1E3A8A" />
                    <GradientStop Offset="1.0" Color="Transparent" />
                </RadialGradientBrush>
            </BoxView.Background>
        </BoxView>

        <!--  אפקט גרדיאנט רקע תחתון  -->
        <BoxView
            CornerRadius="200"
            HeightRequest="400"
            HorizontalOptions="Start"
            TranslationX="-150"
            TranslationY="150"
            VerticalOptions="End"
            WidthRequest="400">
            <BoxView.Background>
                <RadialGradientBrush>
                    <GradientStop Offset="0.0" Color="#1E3A8A" />
                    <GradientStop Offset="1.0" Color="Transparent" />
                </RadialGradientBrush>
            </BoxView.Background>
        </BoxView>

        <Grid
            Padding="20,15,20,0"
            RowDefinitions="Auto, Auto, Auto, *, Auto"
            RowSpacing="12">

            <!--  לוגו האפליקציה  -->
            <Image
                Grid.Row="0"
                HeightRequest="40"
                HorizontalOptions="Center"
                Source="market_mood_logo.png"
                WidthRequest="40">
                <Image.Clip>
                    <EllipseGeometry
                        Center="20,20"
                        RadiusX="20"
                        RadiusY="20" />
                </Image.Clip>
            </Image>

            <!--  כותרת ראשית  -->
            <Label
                Grid.Row="1"
                FontAttributes="Bold"
                FontSize="20"
                HorizontalOptions="Center"
                Text="Live Crypto News"
                TextColor="White" />

            <!--  כפתור רענון חדשות  -->
            <Button
                Grid.Row="2"
                BackgroundColor="#1E3A8A"
                Command="{Binding FetchNewsCommand}"
                CornerRadius="8"
                HeightRequest="35"
                HorizontalOptions="Center"
                Text="🔄 Fetch Latest News"
                WidthRequest="200" />

            <!--  רשימת הכתבות מה-API המעודכן  -->
            <CollectionView
                Grid.Row="3"
                Margin="0,5"
                BackgroundColor="Transparent"
                ItemsSource="{Binding NewsList}"
                SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:NewsArticle">
                        <Border
                            Margin="0,0,0,12"
                            Padding="12"
                            BackgroundColor="#0F172A"
                            Stroke="#1E3A8A"
                            StrokeShape="RoundRectangle 10">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type CollectionView}}, Path=BindingContext.GoToDetailsCommand}" CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>

                            <VerticalStackLayout Spacing="8">
                                <!--  שורת נתוני המקור, הסנטימנט והזמן  -->
                                <HorizontalStackLayout Spacing="8">
                                    <!--  באדג' סנטימנט צבעוני  -->
                                    <Border
                                        Padding="6,2"
                                        BackgroundColor="{Binding SentimentColor}"
                                        StrokeShape="RoundRectangle 4"
                                        StrokeThickness="0">
                                        <Label
                                            FontAttributes="Bold"
                                            FontSize="9"
                                            Text="{Binding Sentiment}"
                                            TextColor="White" />
                                    </Border>

                                    <!--  מקור הכתבה  -->
                                    <Label
                                        FontSize="10"
                                        Text="{Binding Source}"
                                        TextColor="#94A3B8"
                                        VerticalOptions="Center" />

                                    <!--  נקודת הפרדה ויזואלית  -->
                                    <Label
                                        FontSize="10"
                                        Text="•"
                                        TextColor="#64748B"
                                        VerticalOptions="Center" />

                                    <!--  זמן פרסום הכתבה מה-API  -->
                                    <Label
                                        FontSize="10"
                                        Text="{Binding PublishedAt}"
                                        TextColor="#64748B"
                                        VerticalOptions="Center" />
                                </HorizontalStackLayout>

                                <!--  כותרת הכתבה  -->
                                <Label
                                    FontAttributes="Bold"
                                    FontSize="14"
                                    Text="{Binding Title}"
                                    TextColor="White" />

                                <!--  תיאור קצר של הכתבה  -->
                                <Label
                                    FontSize="11"
                                    LineBreakMode="TailTruncation"
                                    MaxLines="2"
                                    Text="{Binding Description}"
                                    TextColor="#94A3B8" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!--  תפריט ניווט תחתון צף  -->
            <components:FloatingNavBar
                Grid.Row="4"
                Margin="0,0,0,10"
                ActivePage="News"
                VerticalOptions="End" />
        </Grid>
    </Grid>
</ContentPage>