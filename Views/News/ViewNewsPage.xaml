<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MarketSentimentFinal.Views.News.ViewNewsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Live Crypto News"
    Shell.NavBarIsVisible="False">

    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Offset="0.0" Color="#0F2027" />
            <GradientStop Offset="0.5" Color="#203A43" />
            <GradientStop Offset="1.0" Color="#2C5364" />
        </LinearGradientBrush>
    </ContentPage.Background>

    <Grid RowDefinitions="Auto, *">

        <Grid
            Grid.Row="0"
            Padding="20,15,20,5"
            ColumnDefinitions="Auto, *, Auto">
            <Button
                Grid.Column="0"
                Padding="15,0"
                BackgroundColor="#1F353D"
                Command="{Binding GoBackCommand}"
                CornerRadius="8"
                FontAttributes="Bold"
                HeightRequest="40"
                HorizontalOptions="Start"
                Text="⬅ Back"
                TextColor="White" />

            <Button
                Grid.Column="1"
                Margin="0,0,10,0"
                Padding="15,0"
                BackgroundColor="#00B4DB"
                Command="{Binding FetchNewsCommand}"
                CornerRadius="8"
                FontAttributes="Bold"
                HeightRequest="40"
                HorizontalOptions="End"
                Text="🔄 Fetch Latest News"
                TextColor="White" />

            <ActivityIndicator
                Grid.Column="2"
                HeightRequest="30"
                IsRunning="{Binding IsLoading}"
                IsVisible="{Binding IsLoading}"
                VerticalOptions="Center"
                WidthRequest="30"
                Color="#00B4DB" />
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="25,20,25,30" Spacing="5">
                <CollectionView ItemsSource="{Binding NewsList}" SelectionMode="None">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,25">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type CollectionView}}, Path=BindingContext.GoToDetailsCommand}" CommandParameter="{Binding .}" />
                                </Grid.GestureRecognizers>

                                <Border
                                    BackgroundColor="#1Affffff"
                                    Stroke="{Binding SentimentColor}"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 15">
                                    <Border.Shadow>
                                        <Shadow 
                                            Brush="{Binding SentimentColor}" 
                                            Radius="14" 
                                            Opacity="0.75" 
                                            Offset="0,0" />
                                    </Border.Shadow>

                                    <Grid BackgroundColor="Transparent" MinimumHeightRequest="80" />
                                </Border>

                                <VerticalStackLayout Padding="20" Spacing="2">
                                    <HorizontalStackLayout Spacing="10" Margin="0,0,0,6">
                                        <Border
                                            Padding="8,3"
                                            BackgroundColor="{Binding SentimentColor}"
                                            StrokeShape="RoundRectangle 5"
                                            StrokeThickness="0">
                                            <Label
                                                FontAttributes="Bold"
                                                FontSize="10"
                                                Text="{Binding Sentiment}"
                                                TextColor="White" />
                                        </Border>
                                        <Label
                                            FontSize="11"
                                            Text="{Binding Source}"
                                            TextColor="#B0BEC5"
                                            FontAttributes="Bold"
                                            VerticalOptions="Center" />
                                        <Label
                                            FontSize="11"
                                            Text="•"
                                            TextColor="#78909C"
                                            VerticalOptions="Center" />
                                        <Label
                                            FontSize="11"
                                            Text="{Binding PublishedAt}"
                                            TextColor="#B0BEC5"
                                            VerticalOptions="Center" />
                                    </HorizontalStackLayout>

                                    <Label
                                        FontAttributes="Bold"
                                        FontSize="18"
                                        Text="{Binding Title}"
                                        TextColor="White"
                                        Margin="0,0,0,4" />

                                    <Label
                                        FontSize="13"
                                        LineBreakMode="TailTruncation"
                                        LineHeight="1.2"
                                        MaxLines="3"
                                        Text="{Binding Description}"
                                        TextColor="#CFD8DC" />
                                </VerticalStackLayout>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>