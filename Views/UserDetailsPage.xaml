<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MarketSentimentFinal.Views.UserDetailsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:MarketSentimentFinal.ViewModels"
    x:DataType="vm:UserDetailsPageViewModel"
    NavigationPage.HasNavigationBar="False">

    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Offset="0.0" Color="#0F2027" />
            <GradientStop Offset="0.5" Color="#203A43" />
            <GradientStop Offset="1.0" Color="#2C5364" />
        </LinearGradientBrush>
    </ContentPage.Background>

    <Grid>
        <ScrollView>
            <VerticalStackLayout Padding="32,70,32,40" Spacing="18">

                <Label
                    Margin="0,0,0,10"
                    CharacterSpacing="1"
                    FontAttributes="Bold"
                    FontSize="28"
                    HorizontalOptions="Center"
                    Text="EDIT PROFILE"
                    TextColor="White" />

                <Border
                    Padding="16,0"
                    BackgroundColor="#22FFFFFF"
                    Stroke="#44FFFFFF"
                    StrokeShape="RoundRectangle 10">
                    <Entry
                        HeightRequest="55"
                        Placeholder="First Name"
                        PlaceholderColor="#BBFFFFFF"
                        Text="{Binding FirstName}"
                        TextColor="White" />
                </Border>

                <Border
                    Padding="16,0"
                    BackgroundColor="#22FFFFFF"
                    Stroke="#44FFFFFF"
                    StrokeShape="RoundRectangle 10">
                    <Entry
                        HeightRequest="55"
                        Placeholder="Last Name"
                        PlaceholderColor="#BBFFFFFF"
                        Text="{Binding LastName}"
                        TextColor="White" />
                </Border>

                <Border
                    Padding="16,0"
                    BackgroundColor="#11000000"
                    Stroke="#22FFFFFF"
                    StrokeShape="RoundRectangle 10">
                    <Entry
                        HeightRequest="55"
                        IsEnabled="False"
                        Placeholder="Email"
                        PlaceholderColor="#66FFFFFF"
                        Text="{Binding Email}"
                        TextColor="#88FFFFFF" />
                </Border>

                <Border
                    Padding="16,0"
                    BackgroundColor="#22FFFFFF"
                    Stroke="#44FFFFFF"
                    StrokeShape="RoundRectangle 10">
                    <Entry
                        HeightRequest="55"
                        Keyboard="Telephone"
                        Placeholder="Mobile"
                        PlaceholderColor="#BBFFFFFF"
                        Text="{Binding Mobile}"
                        TextColor="White" />
                </Border>

                <Button
                    Margin="0,20,0,0"
                    BackgroundColor="#00B4DB"
                    Command="{Binding UpdateCommand}"
                    CornerRadius="10"
                    FontAttributes="Bold"
                    HeightRequest="55"
                    Text="Save Changes"
                    TextColor="White" />

            </VerticalStackLayout>
        </ScrollView>

        <ImageButton
            Margin="0,20,20,0"
            Padding="10"
            BackgroundColor="#FF5252"
            Command="{Binding DeleteCommand}"
            CornerRadius="22"
            HeightRequest="44"
            HorizontalOptions="End"
            IsVisible="{Binding IsDeleteVisible}"
            Source="delete.png"
            VerticalOptions="Start"
            WidthRequest="44" />
    </Grid>
</ContentPage>