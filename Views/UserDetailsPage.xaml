<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MarketSentimentFinal.Views.UserDetailsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:components="clr-namespace:MarketSentimentFinal.Views.Components"
    xmlns:vm="clr-namespace:MarketSentimentFinal.ViewModels"
    x:DataType="vm:UserDetailsPageViewModel"
    Shell.NavBarIsVisible="False">

    <Grid BackgroundColor="#05070A">
        <BoxView
            CornerRadius="200"
            HeightRequest="400"
            HorizontalOptions="End"
            TranslationX="150"
            TranslationY="-150"
            VerticalOptions="Start"
            WidthRequest="400">
            <BoxView.Background>
                <RadialGradientBrush>
                    <GradientStop Offset="0.0" Color="#1E3A8A" />
                    <GradientStop Offset="1.0" Color="Transparent" />
                </RadialGradientBrush>
            </BoxView.Background>
        </BoxView>

        <BoxView
            CornerRadius="200"
            HeightRequest="400"
            HorizontalOptions="Start"
            TranslationX="-150"
            TranslationY="150"
            VerticalOptions="End"
            WidthRequest="400">
            <BoxView.Background>
                <RadialGradientBrush>
                    <GradientStop Offset="0.0" Color="#1E3A8A" />
                    <GradientStop Offset="1.0" Color="Transparent" />
                </RadialGradientBrush>
            </BoxView.Background>
        </BoxView>

        <Grid Padding="20,15,20,0" RowDefinitions="Auto, Auto, *, Auto">

            <VerticalStackLayout
                Grid.Row="0"
                HorizontalOptions="Center"
                Spacing="4">
                <Image
                    HeightRequest="40"
                    Source="market_mood_logo.png"
                    WidthRequest="40">
                    <Image.Clip>
                        <EllipseGeometry
                            Center="20,20"
                            RadiusX="20"
                            RadiusY="20" />
                    </Image.Clip>
                </Image>
            </VerticalStackLayout>

            <Label
                Grid.Row="1"
                Margin="0,10,0,10"
                FontAttributes="Bold"
                FontSize="22"
                HorizontalOptions="Center"
                Text="EDIT PROFILE"
                TextColor="White" />

            <ScrollView Grid.Row="2" Margin="0,5">
                <VerticalStackLayout Padding="10,0" Spacing="15">

                    <Label
                        Margin="5,0"
                        FontSize="12"
                        Text="First Name"
                        TextColor="#94A3B8" />
                    <Border
                        Padding="15,0"
                        BackgroundColor="#0F172A"
                        Stroke="#1E3A8A"
                        StrokeShape="RoundRectangle 10">
                        <Entry
                            HeightRequest="50"
                            PlaceholderColor="#475569"
                            Text="{Binding FirstName}"
                            TextColor="White" />
                    </Border>

                    <Label
                        Margin="5,0"
                        FontSize="12"
                        Text="Last Name"
                        TextColor="#94A3B8" />
                    <Border
                        Padding="15,0"
                        BackgroundColor="#0F172A"
                        Stroke="#1E3A8A"
                        StrokeShape="RoundRectangle 10">
                        <Entry
                            HeightRequest="50"
                            PlaceholderColor="#475569"
                            Text="{Binding LastName}"
                            TextColor="White" />
                    </Border>

                    <Label
                        Margin="5,0"
                        FontSize="12"
                        Text="Email (Read Only)"
                        TextColor="#475569" />
                    <Border
                        Padding="15,0"
                        BackgroundColor="#05070A"
                        Opacity="0.6"
                        Stroke="#334155"
                        StrokeShape="RoundRectangle 10">
                        <Entry
                            HeightRequest="50"
                            IsEnabled="False"
                            Text="{Binding Email}"
                            TextColor="#94A3B8" />
                    </Border>

                    <Label
                        Margin="5,0"
                        FontSize="12"
                        Text="Mobile"
                        TextColor="#94A3B8" />
                    <Border
                        Padding="15,0"
                        BackgroundColor="#0F172A"
                        Stroke="#1E3A8A"
                        StrokeShape="RoundRectangle 10">
                        <Entry
                            HeightRequest="50"
                            Keyboard="Telephone"
                            PlaceholderColor="#475569"
                            Text="{Binding Mobile}"
                            TextColor="White" />
                    </Border>

                    <Button
                        Margin="0,15,0,5"
                        BackgroundColor="#1E3A8A"
                        Command="{Binding UpdateCommand}"
                        CornerRadius="10"
                        FontAttributes="Bold"
                        HeightRequest="50"
                        Text="Save Changes"
                        TextColor="White" />

                    <Button
                        Margin="0,5,0,80"
                        BackgroundColor="Transparent"
                        BorderColor="#EF4444"
                        BorderWidth="1"
                        Command="{Binding DeleteCommand}"
                        CornerRadius="10"
                        HeightRequest="45"
                        IsVisible="{Binding IsDeleteVisible}"
                        Text="Delete Account"
                        TextColor="#EF4444" />
                </VerticalStackLayout>
            </ScrollView>

            <components:FloatingNavBar
                Grid.Row="3"
                Margin="0,0,0,10"
                ActivePage="Account"
                VerticalOptions="End" />
        </Grid>
    </Grid>
</ContentPage>