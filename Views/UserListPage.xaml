<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MarketSentimentFinal.Views.UsersListPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:components="clr-namespace:MarketSentimentFinal.Views.Components"
    xmlns:models="clr-namespace:MarketSentimentFinal.Models"
    xmlns:vm="clr-namespace:MarketSentimentFinal.ViewModels"
    x:DataType="vm:UsersListViewModel"
    BackgroundColor="#05070A"
    Shell.NavBarIsVisible="False">

    <Grid>
        <BoxView
            CornerRadius="200"
            HeightRequest="400"
            HorizontalOptions="End"
            TranslationX="150"
            TranslationY="-150"
            VerticalOptions="Start"
            WidthRequest="400">
            <BoxView.Background>
                <RadialGradientBrush>
                    <GradientStop Offset="0.0" Color="#1E3A8A" />
                    <GradientStop Offset="1.0" Color="Transparent" />
                </RadialGradientBrush>
            </BoxView.Background>
        </BoxView>

        <BoxView
            CornerRadius="200"
            HeightRequest="400"
            HorizontalOptions="Start"
            TranslationX="-150"
            TranslationY="150"
            VerticalOptions="End"
            WidthRequest="400">
            <BoxView.Background>
                <RadialGradientBrush>
                    <GradientStop Offset="0.0" Color="#1E3A8A" />
                    <GradientStop Offset="1.0" Color="Transparent" />
                </RadialGradientBrush>
            </BoxView.Background>
        </BoxView>

        <Grid Padding="20,15,20,0" RowDefinitions="Auto, Auto, *, Auto">

            <VerticalStackLayout Grid.Row="0" HorizontalOptions="Center">
                <Image
                    HeightRequest="40"
                    Source="market_mood_logo.png"
                    WidthRequest="40">
                    <Image.Clip>
                        <EllipseGeometry
                            Center="20,20"
                            RadiusX="20"
                            RadiusY="20" />
                    </Image.Clip>
                </Image>
            </VerticalStackLayout>

            <VerticalStackLayout
                Grid.Row="1"
                Margin="0,10,0,10"
                Spacing="15">
                <Label
                    CharacterSpacing="1.5"
                    FontAttributes="Bold"
                    FontSize="22"
                    HorizontalOptions="Center"
                    Text="USERS DIRECTORY"
                    TextColor="White" />

                <Grid ColumnDefinitions="*, Auto" ColumnSpacing="10">
                    <Border
                        Grid.Column="0"
                        Padding="10,0"
                        BackgroundColor="#0F172A"
                        HeightRequest="48"
                        Stroke="#15FFFFFF"
                        StrokeShape="RoundRectangle 12">
                        <SearchBar
                            BackgroundColor="Transparent"
                            CancelButtonColor="White"
                            Placeholder="Find user by name or email..."
                            PlaceholderColor="#64748B"
                            SearchCommand="{Binding SearchCommand}"
                            Text="{Binding SearchText}"
                            TextColor="White"
                            VerticalOptions="Center" />
                    </Border>

                    <Button
                        Grid.Column="1"
                        Padding="0"
                        BackgroundColor="#1E3A8A"
                        Command="{Binding ClearFilterCommand}"
                        CornerRadius="12"
                        FontAttributes="Bold"
                        FontSize="16"
                        HeightRequest="48"
                        Text="✕"
                        TextColor="White"
                        WidthRequest="48" />
                </Grid>
            </VerticalStackLayout>

            <CollectionView
                x:Name="UsersCollection"
                Grid.Row="2"
                Margin="0,5,0,75"
                ItemsSource="{Binding AllUsers}"
                SelectionMode="None">
                <CollectionView.EmptyView>
                    <VerticalStackLayout
                        Margin="0,100"
                        HorizontalOptions="Center"
                        VerticalOptions="Center">
                        <Label
                            FontSize="16"
                            HorizontalTextAlignment="Center"
                            Text="No registered users found."
                            TextColor="#64748B" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:AppUser">
                        <Border
                            Margin="5,6"
                            Padding="16,14"
                            BackgroundColor="#0F172A"
                            Stroke="#10FFFFFF"
                            StrokeShape="RoundRectangle 14">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding BindingContext.UserDetailsPageCommand, Source={x:Reference UsersCollection}}" CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>

                            <Grid
                                ColumnDefinitions="*, Auto"
                                RowDefinitions="Auto, Auto"
                                RowSpacing="4">
                                <HorizontalStackLayout
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    Spacing="6"
                                    VerticalOptions="Center">
                                    <Label
                                        FontAttributes="Bold"
                                        FontSize="15"
                                        Text="{Binding FirstName}"
                                        TextColor="White" />
                                    <Label
                                        FontAttributes="Bold"
                                        FontSize="15"
                                        Text="{Binding LastName}"
                                        TextColor="White" />
                                </HorizontalStackLayout>

                                <Label
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    FontSize="12"
                                    Text="{Binding Email}"
                                    TextColor="#60A5FA" />

                                <Border
                                    Grid.RowSpan="2"
                                    Grid.Column="1"
                                    Padding="8,4"
                                    BackgroundColor="#15FFFFFF"
                                    StrokeShape="RoundRectangle 6"
                                    StrokeThickness="0"
                                    VerticalOptions="Center">
                                    <Label
                                        FontAttributes="Bold"
                                        FontSize="10"
                                        Text="{Binding RegDate, StringFormat='{0:dd/MM/yyyy}'}"
                                        TextColor="#94A3B8" />
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <components:FloatingNavBar
                Grid.Row="3"
                Margin="0,0,0,10"
                ActivePage="Admin"
                VerticalOptions="End" />
        </Grid>
    </Grid>
</ContentPage>