<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MarketSentimentFinal.Views.LoginPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:MarketSentimentFinal.ViewModels"
    Title="Login"
    x:DataType="vm:LoginViewModel"
    BackgroundColor="#05070A"
    NavigationPage.HasNavigationBar="False">

    <Grid>
        <!--  אפקט גרדיאנט רקע עליון (ימין)  -->
        <BoxView
            CornerRadius="200"
            HeightRequest="400"
            HorizontalOptions="End"
            TranslationX="150"
            TranslationY="-150"
            VerticalOptions="Start"
            WidthRequest="400">
            <BoxView.Background>
                <RadialGradientBrush>
                    <GradientStop Offset="0.0" Color="#1E3A8A" />
                    <GradientStop Offset="1.0" Color="Transparent" />
                </RadialGradientBrush>
            </BoxView.Background>
        </BoxView>

        <!--  אפקט גרדיאנט רקע תחתון (שמאל)  -->
        <BoxView
            CornerRadius="200"
            HeightRequest="400"
            HorizontalOptions="Start"
            TranslationX="-150"
            TranslationY="150"
            VerticalOptions="End"
            WidthRequest="400">
            <BoxView.Background>
                <RadialGradientBrush>
                    <GradientStop Offset="0.0" Color="#1E3A8A" />
                    <GradientStop Offset="1.0" Color="Transparent" />
                </RadialGradientBrush>
            </BoxView.Background>
        </BoxView>

        <ScrollView VerticalOptions="Center">
            <VerticalStackLayout Padding="30" Spacing="25">

                <!--  לוגו האפליקציה המקורי במקום הבוט של דוטנט  -->
                <Image
                    HeightRequest="80"
                    HorizontalOptions="Center"
                    Source="market_mood_logo.png"
                    WidthRequest="80">
                    <Image.Clip>
                        <EllipseGeometry
                            Center="40,40"
                            RadiusX="40"
                            RadiusY="40" />
                    </Image.Clip>
                </Image>

                <VerticalStackLayout HorizontalOptions="Center" Spacing="4">
                    <Label
                        CharacterSpacing="2"
                        FontAttributes="Bold"
                        FontSize="28"
                        HorizontalOptions="Center"
                        Text="MARKET MOOD"
                        TextColor="White" />
                    <Label
                        FontSize="12"
                        HorizontalOptions="Center"
                        Text="AI-Powered Trading Sentiment"
                        TextColor="#64748B" />
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="15">
                    <!--  שדה אימייל מודרני  -->
                    <Border
                        Padding="15,0"
                        BackgroundColor="#0F172A"
                        HeightRequest="52"
                        Stroke="#15FFFFFF"
                        StrokeShape="RoundRectangle 12">
                        <Entry
                            Keyboard="Email"
                            Placeholder="Email Address"
                            PlaceholderColor="#64748B"
                            Text="{Binding UserEmail}"
                            TextColor="White"
                            VerticalOptions="Center" />
                    </Border>

                    <!--  שדה סיסמה מודרני  -->
                    <Border
                        Padding="15,0"
                        BackgroundColor="#0F172A"
                        HeightRequest="52"
                        Stroke="#15FFFFFF"
                        StrokeShape="RoundRectangle 12">
                        <Entry
                            IsPassword="True"
                            Placeholder="Password"
                            PlaceholderColor="#64748B"
                            Text="{Binding UserPassword}"
                            TextColor="White"
                            VerticalOptions="Center" />
                    </Border>
                </VerticalStackLayout>

                <Label
                    FontAttributes="Bold"
                    FontSize="12"
                    HorizontalOptions="Center"
                    Text="{Binding ErrorMessage}"
                    TextColor="#EF4444" />

                <VerticalStackLayout Spacing="15">
                    <!--  כפתור לוגין תואם לצבעי הירוק הזוהר של האפליקציה  -->
                    <Button
                        BackgroundColor="#00E676"
                        CharacterSpacing="1"
                        Command="{Binding LoginCommand}"
                        CornerRadius="12"
                        FontAttributes="Bold"
                        FontSize="14"
                        HeightRequest="52"
                        Text="LOGIN"
                        TextColor="#05070A" />

                    <Button
                        BackgroundColor="Transparent"
                        Command="{Binding GoToSignUpCommand}"
                        FontSize="13"
                        HorizontalOptions="Center"
                        Text="Don't have an account? Sign Up"
                        TextColor="#60A5FA" />
                </VerticalStackLayout>

                <ActivityIndicator
                    HorizontalOptions="Center"
                    IsRunning="{Binding IsBusy}"
                    IsVisible="{Binding IsBusy}"
                    Color="#00E676" />

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>