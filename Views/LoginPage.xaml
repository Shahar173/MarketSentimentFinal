<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MarketSentimentFinal.Views.LoginPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:MarketSentimentFinal.ViewModels"
    Title="Login"
    BackgroundColor="#121212">

    <ScrollView>
        <VerticalStackLayout
            Padding="30"
            Spacing="25"
            VerticalOptions="Center">

            <Image
                Margin="0,0,0,10"
                HeightRequest="120"
                HorizontalOptions="Center"
                Source="dotnet_bot.png" />

            <Label
                FontAttributes="Bold"
                FontSize="32"
                HorizontalOptions="Center"
                Text="Market Sentiment"
                TextColor="#512BD4" />

            <VerticalStackLayout Spacing="15">
                <Border
                    Padding="10,0"
                    BackgroundColor="#1E1E1E"
                    HeightRequest="50"
                    StrokeShape="RoundRectangle 10"
                    StrokeThickness="0">
                    <Entry
                        Keyboard="Email"
                        Placeholder="Email Address"
                        PlaceholderColor="Gray"
                        Text="{Binding UserEmail}"
                        TextColor="White"
                        VerticalOptions="Center" />
                </Border>

                <Border
                    Padding="10,0"
                    BackgroundColor="#1E1E1E"
                    HeightRequest="50"
                    StrokeShape="RoundRectangle 10"
                    StrokeThickness="0">
                    <Entry
                        IsPassword="True"
                        Placeholder="Password"
                        PlaceholderColor="Gray"
                        Text="{Binding UserPassword}"
                        TextColor="White"
                        VerticalOptions="Center" />
                </Border>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="10">
                <Button
                    BackgroundColor="#512BD4"
                    Command="{Binding LoginCommand}"
                    CornerRadius="10"
                    FontAttributes="Bold"
                    HeightRequest="55"
                    Text="Login"
                    TextColor="White" />

                <Button
                    BackgroundColor="Transparent"
                    Command="{Binding GoToSignUpCommand}"
                    FontSize="14"
                    HorizontalOptions="Center"
                    Text="Don't have an account? Sign Up"
                    TextColor="#9D86E9" />
            </VerticalStackLayout>

            <ActivityIndicator
                HorizontalOptions="Center"
                IsRunning="{Binding IsBusy}"
                IsVisible="{Binding IsBusy}"
                Color="#512BD4" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>