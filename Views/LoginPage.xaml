<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MarketSentimentFinal.Views.LoginPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:MarketSentimentFinal.ViewModels"
    Title="Login"
    BackgroundColor="#121212">

    <ContentPage.BindingContext>
        <vm:LoginViewModel />
    </ContentPage.BindingContext>

    <ScrollView>
        <VerticalStackLayout
            Padding="30"
            Spacing="25"
            VerticalOptions="Center">

            <Image
                Margin="0,0,0,10"
                HeightRequest="120"
                HorizontalOptions="Center"
                Source="dotnet_bot.png" />

            <Label
                FontAttributes="Bold"
                FontSize="32"
                HorizontalOptions="Center"
                Text="Market Sentiment"
                TextColor="#512BD4" />

            <Label
                Margin="0,-15,0,10"
                FontSize="16"
                HorizontalOptions="Center"
                Text="Sign in to continue your analysis"
                TextColor="Gray" />

            <Frame
                Padding="0"
                BackgroundColor="#1E1E1E"
                CornerRadius="10"
                HasShadow="False">
                <Entry
                    Margin="10,0"
                    HeightRequest="50"
                    Keyboard="Email"
                    Placeholder="Email Address"
                    PlaceholderColor="Gray"
                    Text="{Binding UserEmail}"
                    TextColor="White" />
            </Frame>

            <Frame
                Padding="0"
                BackgroundColor="#1E1E1E"
                CornerRadius="10"
                HasShadow="False">
                <Entry
                    Margin="10,0"
                    HeightRequest="50"
                    IsPassword="True"
                    Placeholder="Password"
                    PlaceholderColor="Gray"
                    Text="{Binding UserPassword}"
                    TextColor="White" />
            </Frame>

            <Button
                Margin="0,10,0,0"
                BackgroundColor="#512BD4"
                Command="{Binding LoginCommand}"
                CornerRadius="10"
                FontAttributes="Bold"
                FontSize="18"
                HeightRequest="55"
                Text="Login"
                TextColor="White" />

            <ActivityIndicator
                HorizontalOptions="Center"
                IsRunning="{Binding IsBusy}"
                IsVisible="{Binding IsBusy}"
                Color="#512BD4" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>