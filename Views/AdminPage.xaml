<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MarketSentimentFinal.Views.AdminPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:components="clr-namespace:MarketSentimentFinal.Views.Components"
    xmlns:vm="clr-namespace:MarketSentimentFinal.ViewModels"
    x:DataType="vm:AdminPageViewModel"
    ClassId="AdminPage"
    Shell.NavBarIsVisible="False">

    <Grid BackgroundColor="#05070A">
        <BoxView
            CornerRadius="200"
            HeightRequest="400"
            HorizontalOptions="End"
            TranslationX="150"
            TranslationY="-150"
            VerticalOptions="Start"
            WidthRequest="400">
            <BoxView.Background>
                <RadialGradientBrush>
                    <GradientStop Offset="0.0" Color="#1E3A8A" />
                    <GradientStop Offset="1.0" Color="Transparent" />
                </RadialGradientBrush>
            </BoxView.Background>
        </BoxView>

        <BoxView
            CornerRadius="200"
            HeightRequest="400"
            HorizontalOptions="Start"
            TranslationX="-150"
            TranslationY="150"
            VerticalOptions="End"
            WidthRequest="400">
            <BoxView.Background>
                <RadialGradientBrush>
                    <GradientStop Offset="0.0" Color="#1E3A8A" />
                    <GradientStop Offset="1.0" Color="Transparent" />
                </RadialGradientBrush>
            </BoxView.Background>
        </BoxView>

        <Grid Padding="20,15,20,0" RowDefinitions="Auto, Auto, *, Auto">

            <VerticalStackLayout Grid.Row="0" HorizontalOptions="Center">
                <Image
                    HeightRequest="40"
                    Source="market_mood_logo.png"
                    WidthRequest="40">
                    <Image.Clip>
                        <EllipseGeometry
                            Center="20,20"
                            RadiusX="20"
                            RadiusY="20" />
                    </Image.Clip>
                </Image>
            </VerticalStackLayout>

            <Label
                Grid.Row="1"
                Margin="0,15,0,15"
                CharacterSpacing="2"
                FontAttributes="Bold"
                FontSize="24"
                HorizontalOptions="Center"
                Text="ADMIN PANEL"
                TextColor="White" />

            <VerticalStackLayout
                Grid.Row="2"
                Spacing="20"
                VerticalOptions="Center">
                <Border
                    Padding="25"
                    BackgroundColor="#0F172A"
                    Stroke="#15FFFFFF"
                    StrokeShape="RoundRectangle 16">

                    <VerticalStackLayout Spacing="25">
                        <VerticalStackLayout HorizontalOptions="Center" Spacing="6">
                            <Label
                                FontAttributes="Bold"
                                FontSize="18"
                                HorizontalOptions="Center"
                                Text="Security &amp; Management"
                                TextColor="White" />
                            <Label
                                FontSize="12"
                                HorizontalOptions="Center"
                                HorizontalTextAlignment="Center"
                                Text="Manage application users and security credentials"
                                TextColor="#64748B" />
                        </VerticalStackLayout>

                        <Button
                            BackgroundColor="#1E3A8A"
                            CharacterSpacing="1"
                            Command="{Binding ViewUsersCommand}"
                            CornerRadius="12"
                            FontAttributes="Bold"
                            FontSize="15"
                            HeightRequest="52"
                            Text="VIEW USERS LIST"
                            TextColor="White" />
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>

            <components:FloatingNavBar
                Grid.Row="3"
                Margin="0,0,0,10"
                ActivePage="Admin"
                VerticalOptions="End" />
        </Grid>
    </Grid>
</ContentPage>