<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MarketSentimentFinal.Views.AdminPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:MarketSentimentFinal.ViewModels"
    x:DataType="vm:AdminPageViewModel"
    ClassId="AdminPage"
    NavigationPage.HasNavigationBar="False">

    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Offset="0.0" Color="#0F2027" />
            <GradientStop Offset="0.5" Color="#203A43" />
            <GradientStop Offset="1.0" Color="#2C5364" />
        </LinearGradientBrush>
    </ContentPage.Background>

    <VerticalStackLayout Padding="24,60,24,40" Spacing="30">

        <VerticalStackLayout Spacing="8">
            <Label
                CharacterSpacing="2"
                FontAttributes="Bold"
                FontSize="28"
                HorizontalOptions="Center"
                Text="ADMIN PANEL"
                TextColor="White" />

            <BoxView
                BackgroundColor="#00B4DB"
                HeightRequest="2"
                HorizontalOptions="Center"
                WidthRequest="60" />
        </VerticalStackLayout>

        <Border
            Padding="24"
            BackgroundColor="#22FFFFFF"
            Stroke="#44FFFFFF"
            StrokeShape="RoundRectangle 15"
            StrokeThickness="1">

            <VerticalStackLayout Spacing="20">
                <Label
                    FontSize="16"
                    HorizontalOptions="Center"
                    Text="Manage application users and security"
                    TextColor="#BBFFFFFF" />

                <Button
                    BackgroundColor="#00B4DB"
                    Command="{Binding ViewUsersCommand}"
                    CornerRadius="12"
                    FontAttributes="Bold"
                    FontSize="18"
                    HeightRequest="60"
                    HorizontalOptions="Fill"
                    Text="View Users List"
                    TextColor="White" />
            </VerticalStackLayout>
        </Border>

    </VerticalStackLayout>
</ContentPage>