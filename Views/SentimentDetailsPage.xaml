<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MarketSentimentFinal.Views.SentimentDetailsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Market Sentiment Diagnostic"
    Shell.NavBarIsVisible="False">

    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Offset="0.0" Color="#0F2027" />
            <GradientStop Offset="0.5" Color="#203A43" />
            <GradientStop Offset="1.0" Color="#2C5364" />
        </LinearGradientBrush>
    </ContentPage.Background>

    <Grid RowDefinitions="Auto, *">
        <Grid
            Grid.Row="0"
            Padding="20,15,20,5"
            ColumnDefinitions="Auto, *">
            <Button
                Grid.Column="0"
                Padding="15,0"
                BackgroundColor="#1F353D"
                Command="{Binding GoBackCommand}"
                CornerRadius="8"
                FontAttributes="Bold"
                HeightRequest="40"
                Text="⬅ Back"
                TextColor="White" />
            <Label
                Grid.Column="1"
                Margin="0,0,70,0"
                CharacterSpacing="1"
                FontAttributes="Bold"
                FontSize="16"
                HorizontalOptions="Center"
                Text="ANALYTICS HUB"
                TextColor="White"
                VerticalOptions="Center" />
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="25,15,25,30" Spacing="25">

                <Grid>
                    <Border
                        BackgroundColor="#1Affffff"
                        Stroke="{Binding StateColorGlow}"
                        StrokeShape="RoundRectangle 20"
                        StrokeThickness="1">
                        <Border.Shadow>
                            <Shadow
                                Brush="{Binding StateColorGlow}"
                                Opacity="0.7"
                                Radius="15"
                                Offset="0,0" />
                        </Border.Shadow>
                        <Grid BackgroundColor="Transparent" MinimumHeightRequest="220" />
                    </Border>

                    <VerticalStackLayout
                        Padding="25"
                        HorizontalOptions="Center"
                        Spacing="10"
                        VerticalOptions="Center">
                        <Label
                            CharacterSpacing="1"
                            FontAttributes="Bold"
                            FontSize="12"
                            HorizontalOptions="Center"
                            Text="OVERALL SENTIMENT SCORE"
                            TextColor="#B0BEC5" />

                        <HorizontalStackLayout HorizontalOptions="Center" VerticalOptions="Center">
                            <Label
                                FontAttributes="Bold"
                                FontSize="56"
                                Text="{Binding SentimentScore}"
                                TextColor="White" />
                            <Label
                                Margin="0,0,0,10"
                                FontSize="22"
                                Text="/100"
                                TextColor="#78909C"
                                VerticalOptions="End" />
                        </HorizontalStackLayout>

                        <Border
                            Padding="16,6"
                            BackgroundColor="{Binding StateColorGlow}"
                            HorizontalOptions="Center"
                            StrokeShape="RoundRectangle 10"
                            StrokeThickness="0">
                            <Label
                                FontAttributes="Bold"
                                FontSize="14"
                                Text="{Binding MarketStateText}"
                                TextColor="White" />
                        </Border>
                    </VerticalStackLayout>
                </Grid>

                <Grid ColumnDefinitions="*, *" ColumnSpacing="15">
                    <Grid Grid.Column="0">
                        <Border
                            BackgroundColor="#1Affffff"
                            Stroke="#33FFFFFF"
                            StrokeShape="RoundRectangle 15"
                            StrokeThickness="1" />
                        <VerticalStackLayout
                            Padding="15"
                            HorizontalOptions="Center"
                            Spacing="5">
                            <Label
                                FontAttributes="Bold"
                                FontSize="11"
                                HorizontalOptions="Center"
                                Text="WEEKLY TREND"
                                TextColor="#B0BEC5" />
                            <Label
                                Margin="0,5,0,0"
                                FontAttributes="Bold"
                                FontSize="18"
                                HorizontalOptions="Center"
                                Text="{Binding MarketTrendText}"
                                TextColor="{Binding TrendColorText}" />
                        </VerticalStackLayout>
                    </Grid>

                    <Grid Grid.Column="1">
                        <Border
                            BackgroundColor="#1Affffff"
                            Stroke="#33FFFFFF"
                            StrokeShape="RoundRectangle 15"
                            StrokeThickness="1" />
                        <VerticalStackLayout
                            Padding="15"
                            HorizontalOptions="Center"
                            Spacing="5">
                            <Label
                                FontAttributes="Bold"
                                FontSize="11"
                                HorizontalOptions="Center"
                                Text="DIAGNOSTIC STATUS"
                                TextColor="#B0BEC5" />
                            <Label
                                Margin="0,5,0,0"
                                FontAttributes="Bold"
                                FontSize="18"
                                HorizontalOptions="Center"
                                Text="Live Sync"
                                TextColor="#00B4DB" />
                        </VerticalStackLayout>
                    </Grid>
                </Grid>

                <Grid>
                    <Border
                        BackgroundColor="#1Affffff"
                        Stroke="#22FFFFFF"
                        StrokeShape="RoundRectangle 15"
                        StrokeThickness="1" />
                    <VerticalStackLayout Padding="20" Spacing="12">
                        <Label
                            CharacterSpacing="1"
                            FontAttributes="Bold"
                            FontSize="13"
                            Text="DIAGNOSTIC EXPLANATION"
                            TextColor="#00B4DB" />
                        <BoxView HeightRequest="1" Color="#22FFFFFF" />
                        <Label
                            FontSize="15"
                            LineHeight="1.4"
                            Text="{Binding ExplanationText}"
                            TextColor="#CFD8DC" />
                    </VerticalStackLayout>
                </Grid>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>