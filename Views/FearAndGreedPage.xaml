<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MarketSentimentFinal.Views.FearAndGreedPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:MarketSentimentFinal.ViewModels"
    Title="Fear &amp; Greed Historical Index"
    Shell.NavBarIsVisible="False">

    <Grid BackgroundColor="#05070A">
        <BoxView
            CornerRadius="200"
            HeightRequest="400"
            HorizontalOptions="End"
            TranslationX="150"
            TranslationY="-150"
            VerticalOptions="Start"
            WidthRequest="400">
            <BoxView.Background>
                <RadialGradientBrush>
                    <GradientStop Offset="0.0" Color="#1E3A8A" />
                    <GradientStop Offset="1.0" Color="Transparent" />
                </RadialGradientBrush>
            </BoxView.Background>
        </BoxView>

        <BoxView
            CornerRadius="200"
            HeightRequest="400"
            HorizontalOptions="Start"
            TranslationX="-150"
            TranslationY="150"
            VerticalOptions="End"
            WidthRequest="400">
            <BoxView.Background>
                <RadialGradientBrush>
                    <GradientStop Offset="0.0" Color="#1E3A8A" />
                    <GradientStop Offset="1.0" Color="Transparent" />
                </RadialGradientBrush>
            </BoxView.Background>
        </BoxView>

        <Grid RowDefinitions="Auto, *">
            <Grid
                Grid.Row="0"
                Padding="20,15,20,5"
                ColumnDefinitions="Auto, *">
                <Button
                    Grid.Column="0"
                    Padding="15,0"
                    BackgroundColor="#1E3A8A"
                    Command="{Binding GoBackCommand}"
                    CornerRadius="8"
                    FontAttributes="Bold"
                    HeightRequest="40"
                    Text="⬅ Back"
                    TextColor="White" />
                <Label
                    Grid.Column="1"
                    Margin="0,0,70,0"
                    CharacterSpacing="1"
                    FontAttributes="Bold"
                    FontSize="16"
                    HorizontalOptions="Center"
                    Text="HISTORICAL INDEX"
                    TextColor="White"
                    VerticalOptions="Center" />
            </Grid>

            <ScrollView Grid.Row="1">
                <VerticalStackLayout Padding="25,15,25,30" Spacing="25">

                    <Grid>
                        <Border
                            BackgroundColor="#0F172A"
                            Stroke="{Binding IndexColorGlow}"
                            StrokeShape="RoundRectangle 20"
                            StrokeThickness="1">
                            <Border.Shadow>
                                <Shadow
                                    Brush="{Binding IndexColorGlow}"
                                    Opacity="0.4"
                                    Radius="15"
                                    Offset="0,0" />
                            </Border.Shadow>
                            <Grid MinimumHeightRequest="150" />
                        </Border>

                        <VerticalStackLayout
                            Padding="20"
                            HorizontalOptions="Center"
                            Spacing="8"
                            VerticalOptions="Center">
                            <Label
                                CharacterSpacing="1"
                                FontAttributes="Bold"
                                FontSize="12"
                                HorizontalOptions="Center"
                                Text="CURRENT INDEX VALUE"
                                TextColor="#94A3B8" />
                            <HorizontalStackLayout HorizontalOptions="Center" VerticalOptions="Center">
                                <Label
                                    FontAttributes="Bold"
                                    FontSize="52"
                                    Text="{Binding CurrentIndexValue}"
                                    TextColor="White" />
                                <Label
                                    Margin="0,0,0,8"
                                    FontSize="20"
                                    Text="/100"
                                    TextColor="#64748B"
                                    VerticalOptions="End" />
                            </HorizontalStackLayout>
                            <Border
                                Padding="18,5"
                                BackgroundColor="{Binding IndexColorGlow}"
                                HorizontalOptions="Center"
                                StrokeShape="RoundRectangle 10"
                                StrokeThickness="0">
                                <Label
                                    FontAttributes="Bold"
                                    FontSize="14"
                                    Text="{Binding IndexClassificationText}"
                                    TextColor="White" />
                            </Border>
                        </VerticalStackLayout>
                    </Grid>

                    <Grid>
                        <Border
                            BackgroundColor="#0F172A"
                            Stroke="#1E3A8A"
                            StrokeShape="RoundRectangle 20"
                            StrokeThickness="1" />

                        <VerticalStackLayout Padding="20" Spacing="15">
                            <Label
                                CharacterSpacing="0.5"
                                FontAttributes="Bold"
                                FontSize="12"
                                Text="7-DAY HISTORICAL LOG"
                                TextColor="#94A3B8" />

                            <BoxView HeightRequest="1" Color="#15FFFFFF" />

                            <CollectionView ItemsSource="{Binding HistoricalList}" SelectionMode="None">
                                <CollectionView.ItemTemplate>
                                    <DataTemplate x:DataType="models:HistoricalIndexItem">
                                        <Grid Padding="0,10" ColumnDefinitions="*, Auto, Auto">
                                            <Label
                                                Grid.Column="0"
                                                FontAttributes="Bold"
                                                FontSize="14"
                                                Text="{Binding DayName}"
                                                TextColor="White"
                                                VerticalOptions="Center" />

                                            <Border
                                                Grid.Column="1"
                                                Margin="0,0,20,0"
                                                Padding="10,3"
                                                BackgroundColor="{Binding ClassificationColor}"
                                                StrokeShape="RoundRectangle 6"
                                                StrokeThickness="0"
                                                VerticalOptions="Center">
                                                <Label
                                                    FontAttributes="Bold"
                                                    FontSize="11"
                                                    Text="{Binding Classification}"
                                                    TextColor="White" />
                                            </Border>

                                            <HorizontalStackLayout
                                                Grid.Column="2"
                                                HorizontalOptions="End"
                                                VerticalOptions="Center">
                                                <Label
                                                    FontAttributes="Bold"
                                                    FontSize="15"
                                                    Text="{Binding Value}"
                                                    TextColor="White" />
                                                <Label
                                                    Margin="2,0,0,0"
                                                    FontSize="12"
                                                    Text="/100"
                                                    TextColor="#64748B"
                                                    VerticalOptions="End" />
                                            </HorizontalStackLayout>
                                        </Grid>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </VerticalStackLayout>
                    </Grid>

                    <Grid>
                        <Border
                            BackgroundColor="#0F172A"
                            Stroke="#1E3A8A"
                            StrokeShape="RoundRectangle 15"
                            StrokeThickness="1" />
                        <VerticalStackLayout Padding="20" Spacing="12">
                            <Label
                                FontAttributes="Bold"
                                FontSize="12"
                                Text="INDEX VALUATION MATRICES"
                                TextColor="#94A3B8" />
                            <BoxView HeightRequest="1" Color="#15FFFFFF" />

                            <Grid Margin="0,2" ColumnDefinitions="*, Auto">
                                <Label
                                    FontSize="13"
                                    Text="0–25 → Extreme Fear"
                                    TextColor="#FF5252" />
                                <Label
                                    Grid.Column="1"
                                    FontAttributes="Italic"
                                    FontSize="11"
                                    Text="Deep Discount"
                                    TextColor="#64748B" />
                            </Grid>
                            <Grid Margin="0,2" ColumnDefinitions="*, Auto">
                                <Label
                                    FontSize="13"
                                    Text="26–45 → Fear"
                                    TextColor="#FFAB40" />
                                <Label
                                    Grid.Column="1"
                                    FontAttributes="Italic"
                                    FontSize="11"
                                    Text="Accumulation Phase"
                                    TextColor="#64748B" />
                            </Grid>
                            <Grid Margin="0,2" ColumnDefinitions="*, Auto">
                                <Label
                                    FontSize="13"
                                    Text="46–55 → Neutral"
                                    TextColor="#B0BEC5" />
                                <Label
                                    Grid.Column="1"
                                    FontAttributes="Italic"
                                    FontSize="11"
                                    Text="Sideways Consolidation"
                                    TextColor="#64748B" />
                            </Grid>
                            <Grid Margin="0,2" ColumnDefinitions="*, Auto">
                                <Label
                                    FontSize="13"
                                    Text="56–75 → Greed"
                                    TextColor="#00E676" />
                                <Label
                                    Grid.Column="1"
                                    FontAttributes="Italic"
                                    FontSize="11"
                                    Text="Momentum Expansion"
                                    TextColor="#64748B" />
                            </Grid>
                            <Grid Margin="0,2" ColumnDefinitions="*, Auto">
                                <Label
                                    FontSize="13"
                                    Text="76–100 → Extreme Greed"
                                    TextColor="#00E5FF" />
                                <Label
                                    Grid.Column="1"
                                    FontAttributes="Italic"
                                    FontSize="11"
                                    Text="Distribution Risk High"
                                    TextColor="#64748B" />
                            </Grid>
                        </VerticalStackLayout>
                    </Grid>

                    <Grid>
                        <Border
                            BackgroundColor="#0F172A"
                            Stroke="#15FFFFFF"
                            StrokeShape="RoundRectangle 15"
                            StrokeThickness="1" />
                        <VerticalStackLayout Padding="20" Spacing="10">
                            <Label
                                FontAttributes="Bold"
                                FontSize="12"
                                Text="HISTORICAL TREND ANALYSIS"
                                TextColor="#94A3B8" />
                            <BoxView HeightRequest="1" Color="#15FFFFFF" />
                            <Label
                                FontSize="14"
                                LineHeight="1.4"
                                Text="{Binding ExplanationText}"
                                TextColor="#94A3B8" />
                        </VerticalStackLayout>
                    </Grid>

                </VerticalStackLayout>
            </ScrollView>
        </Grid>
    </Grid>
</ContentPage>