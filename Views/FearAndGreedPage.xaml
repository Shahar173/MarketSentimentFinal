<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MarketSentimentFinal.Views.FearAndGreedPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Fear &amp; Greed Historical Index"
    Shell.NavBarIsVisible="False">

    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Offset="0.0" Color="#0F2027" />
            <GradientStop Offset="0.5" Color="#203A43" />
            <GradientStop Offset="1.0" Color="#2C5364" />
        </LinearGradientBrush>
    </ContentPage.Background>

    <Grid RowDefinitions="Auto, *">
        <Grid
            Grid.Row="0"
            Padding="20,15,20,5"
            ColumnDefinitions="Auto, *">
            <Button
                Grid.Column="0"
                Padding="15,0"
                BackgroundColor="#1F353D"
                Command="{Binding GoBackCommand}"
                CornerRadius="8"
                FontAttributes="Bold"
                HeightRequest="40"
                Text="⬅ Back"
                TextColor="White" />
            <Label
                Grid.Column="1"
                Margin="0,0,70,0"
                CharacterSpacing="1"
                FontAttributes="Bold"
                FontSize="16"
                HorizontalOptions="Center"
                Text="HISTORICAL INDEX"
                TextColor="White"
                VerticalOptions="Center" />
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="25,15,25,30" Spacing="25">

                <Grid>
                    <Border
                        BackgroundColor="#1Affffff"
                        Stroke="{Binding IndexColorGlow}"
                        StrokeShape="RoundRectangle 20"
                        StrokeThickness="1">
                        <Border.Shadow>
                            <Shadow
                                Brush="{Binding IndexColorGlow}"
                                Opacity="0.6"
                                Radius="15"
                                Offset="0,0" />
                        </Border.Shadow>
                        <Grid MinimumHeightRequest="150" />
                    </Border>

                    <VerticalStackLayout
                        Padding="20"
                        HorizontalOptions="Center"
                        Spacing="8"
                        VerticalOptions="Center">
                        <Label
                            CharacterSpacing="1"
                            FontAttributes="Bold"
                            FontSize="12"
                            HorizontalOptions="Center"
                            Text="CURRENT INDEX VALUE"
                            TextColor="#B0BEC5" />
                        <HorizontalStackLayout HorizontalOptions="Center" VerticalOptions="Center">
                            <Label
                                FontAttributes="Bold"
                                FontSize="52"
                                Text="{Binding CurrentIndexValue}"
                                TextColor="White" />
                            <Label
                                Margin="0,0,0,8"
                                FontSize="20"
                                Text="/100"
                                TextColor="#78909C"
                                VerticalOptions="End" />
                        </HorizontalStackLayout>
                        <Border
                            Padding="18,5"
                            BackgroundColor="{Binding IndexColorGlow}"
                            HorizontalOptions="Center"
                            StrokeShape="RoundRectangle 10"
                            StrokeThickness="0">
                            <Label
                                FontAttributes="Bold"
                                FontSize="14"
                                Text="{Binding IndexClassificationText}"
                                TextColor="White" />
                        </Border>
                    </VerticalStackLayout>
                </Grid>

                <Grid>
                    <Border
                        BackgroundColor="#1Affffff"
                        Stroke="#22FFFFFF"
                        StrokeShape="RoundRectangle 20"
                        StrokeThickness="1" />
                    <VerticalStackLayout Padding="20" Spacing="15">
                        <Label
                            CharacterSpacing="0.5"
                            FontAttributes="Bold"
                            FontSize="12"
                            Text="FEAR &amp; GREED GRADIENT GRAPH"
                            TextColor="#00B4DB" />

                        <Grid Margin="0,10,0,0" HeightRequest="200">
                            <BoxView
                                Margin="40,0,0,0"
                                HeightRequest="1"
                                VerticalOptions="Start"
                                Color="#15FFFFFF" />
                            <BoxView
                                Margin="40,0,0,0"
                                HeightRequest="1"
                                VerticalOptions="Center"
                                Color="#15FFFFFF" />
                            <BoxView
                                Margin="40,0,0,0"
                                HeightRequest="1"
                                VerticalOptions="End"
                                Color="#33FFFFFF" />

                            <VerticalStackLayout
                                HorizontalOptions="Start"
                                Spacing="65"
                                VerticalOptions="Center"
                                WidthRequest="35">
                                <Label
                                    FontSize="10"
                                    HorizontalOptions="End"
                                    Text="100"
                                    TextColor="#78909C" />
                                <Label
                                    FontSize="10"
                                    HorizontalOptions="End"
                                    Text="50"
                                    TextColor="#78909C" />
                                <Label
                                    FontSize="10"
                                    HorizontalOptions="End"
                                    Text="0"
                                    TextColor="#78909C" />
                            </VerticalStackLayout>

                            <Grid Margin="45,10,10,10" HeightRequest="180">
                                <Polyline
                                    Points="{Binding GraphPoints}"
                                    Stroke="{Binding IndexColorGlow}"
                                    StrokeThickness="3" />
                            </Grid>
                        </Grid>

                        <Grid Margin="45,0,10,0" ColumnDefinitions="*, *, *, *, *">
                            <Label
                                Grid.Column="0"
                                FontSize="11"
                                HorizontalOptions="Start"
                                Text="Mon"
                                TextColor="#78909C" />
                            <Label
                                Grid.Column="1"
                                FontSize="11"
                                HorizontalOptions="Center"
                                Text="Tue"
                                TextColor="#78909C" />
                            <Label
                                Grid.Column="2"
                                FontSize="11"
                                HorizontalOptions="Center"
                                Text="Wed"
                                TextColor="#78909C" />
                            <Label
                                Grid.Column="3"
                                FontSize="11"
                                HorizontalOptions="Center"
                                Text="Thu"
                                TextColor="#78909C" />
                            <Label
                                Grid.Column="4"
                                FontSize="11"
                                HorizontalOptions="End"
                                Text="Fri"
                                TextColor="#78909C" />
                        </Grid>
                    </VerticalStackLayout>
                </Grid>

                <Grid>
                    <Border
                        BackgroundColor="#1Affffff"
                        Stroke="#22FFFFFF"
                        StrokeShape="RoundRectangle 15"
                        StrokeThickness="1" />
                    <VerticalStackLayout Padding="20" Spacing="12">
                        <Label
                            FontAttributes="Bold"
                            FontSize="12"
                            Text="INDEX VALUATION MATRICES"
                            TextColor="#00B4DB" />
                        <BoxView HeightRequest="1" Color="#22FFFFFF" />

                        <Grid Margin="0,2" ColumnDefinitions="*, Auto">
                            <Label
                                FontSize="13"
                                Text="0–25 → Extreme Fear"
                                TextColor="#FF5252" />
                            <Label
                                Grid.Column="1"
                                FontAttributes="Italic"
                                FontSize="11"
                                Text="Deep Discount"
                                TextColor="#78909C" />
                        </Grid>
                        <Grid Margin="0,2" ColumnDefinitions="*, Auto">
                            <Label
                                FontSize="13"
                                Text="26–45 → Fear"
                                TextColor="#FFAB40" />
                            <Label
                                Grid.Column="1"
                                FontAttributes="Italic"
                                FontSize="11"
                                Text="Accumulation Phase"
                                TextColor="#78909C" />
                        </Grid>
                        <Grid Margin="0,2" ColumnDefinitions="*, Auto">
                            <Label
                                FontSize="13"
                                Text="46–55 → Neutral"
                                TextColor="#B0BEC5" />
                            <Label
                                Grid.Column="1"
                                FontAttributes="Italic"
                                FontSize="11"
                                Text="Sideways Consolidation"
                                TextColor="#78909C" />
                        </Grid>
                        <Grid Margin="0,2" ColumnDefinitions="*, Auto">
                            <Label
                                FontSize="13"
                                Text="56–75 → Greed"
                                TextColor="#00E676" />
                            <Label
                                Grid.Column="1"
                                FontAttributes="Italic"
                                FontSize="11"
                                Text="Momentum Expansion"
                                TextColor="#78909C" />
                        </Grid>
                        <Grid Margin="0,2" ColumnDefinitions="*, Auto">
                            <Label
                                FontSize="13"
                                Text="76–100 → Extreme Greed"
                                TextColor="#00E5FF" />
                            <Label
                                Grid.Column="1"
                                FontAttributes="Italic"
                                FontSize="11"
                                Text="Distribution Risk High"
                                TextColor="#78909C" />
                        </Grid>
                    </VerticalStackLayout>
                </Grid>

                <Grid>
                    <Border
                        BackgroundColor="#1Affffff"
                        Stroke="#15FFFFFF"
                        StrokeShape="RoundRectangle 15"
                        StrokeThickness="1" />
                    <VerticalStackLayout Padding="20" Spacing="10">
                        <Label
                            FontAttributes="Bold"
                            FontSize="12"
                            Text="HISTORICAL TREND ANALYSIS"
                            TextColor="#00B4DB" />
                        <BoxView HeightRequest="1" Color="#15FFFFFF" />
                        <Label
                            FontSize="14"
                            LineHeight="1.4"
                            Text="{Binding ExplanationText}"
                            TextColor="#CFD8DC" />
                    </VerticalStackLayout>
                </Grid>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>