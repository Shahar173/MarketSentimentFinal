<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MarketSentimentFinal.Views.SignUpPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:MarketSentimentFinal.ViewModels"
    Title="Create Account"
    x:DataType="vm:SignUpViewModel"
    BackgroundColor="#05070A"
    NavigationPage.HasNavigationBar="False"
    Shell.NavBarIsVisible="False">

    <Grid>
        <!--  אפקט גרדיאנט רקע עליון (ימין)  -->
        <BoxView
            CornerRadius="200"
            HeightRequest="400"
            HorizontalOptions="End"
            TranslationX="150"
            TranslationY="-150"
            VerticalOptions="Start"
            WidthRequest="400">
            <BoxView.Background>
                <RadialGradientBrush>
                    <GradientStop Offset="0.0" Color="#1E3A8A" />
                    <GradientStop Offset="1.0" Color="Transparent" />
                </RadialGradientBrush>
            </BoxView.Background>
        </BoxView>

        <!--  אפקט גרדיאנט רקע תחתון (שמאל)  -->
        <BoxView
            CornerRadius="200"
            HeightRequest="400"
            HorizontalOptions="Start"
            TranslationX="-150"
            TranslationY="150"
            VerticalOptions="End"
            WidthRequest="400">
            <BoxView.Background>
                <RadialGradientBrush>
                    <GradientStop Offset="0.0" Color="#1E3A8A" />
                    <GradientStop Offset="1.0" Color="Transparent" />
                </RadialGradientBrush>
            </BoxView.Background>
        </BoxView>

        <ScrollView VerticalOptions="Center">
            <VerticalStackLayout Padding="30" Spacing="15">

                <VerticalStackLayout
                    Margin="0,0,0,10"
                    HorizontalOptions="Center"
                    Spacing="4">
                    <Label
                        CharacterSpacing="1.5"
                        FontAttributes="Bold"
                        FontSize="26"
                        HorizontalOptions="Center"
                        Text="CREATE ACCOUNT"
                        TextColor="White" />
                    <Label
                        FontSize="12"
                        HorizontalOptions="Center"
                        Text="Join our intelligent trading community"
                        TextColor="#64748B" />
                </VerticalStackLayout>

                <!--  שדות קלט במבנה Border מעוצב ואחיד  -->
                <Border
                    Padding="15,0"
                    BackgroundColor="#0F172A"
                    HeightRequest="50"
                    Stroke="#15FFFFFF"
                    StrokeShape="RoundRectangle 12">
                    <Entry
                        Placeholder="First Name"
                        PlaceholderColor="#64748B"
                        Text="{Binding FirstName}"
                        TextColor="White"
                        VerticalOptions="Center" />
                </Border>

                <Border
                    Padding="15,0"
                    BackgroundColor="#0F172A"
                    HeightRequest="50"
                    Stroke="#15FFFFFF"
                    StrokeShape="RoundRectangle 12">
                    <Entry
                        Placeholder="Last Name"
                        PlaceholderColor="#64748B"
                        Text="{Binding LastName}"
                        TextColor="White"
                        VerticalOptions="Center" />
                </Border>

                <Border
                    Padding="15,0"
                    BackgroundColor="#0F172A"
                    HeightRequest="50"
                    Stroke="#15FFFFFF"
                    StrokeShape="RoundRectangle 12">
                    <Entry
                        Keyboard="Email"
                        Placeholder="Email Address"
                        PlaceholderColor="#64748B"
                        Text="{Binding Email}"
                        TextColor="White"
                        VerticalOptions="Center" />
                </Border>

                <Border
                    Padding="15,0"
                    BackgroundColor="#0F172A"
                    HeightRequest="50"
                    Stroke="#15FFFFFF"
                    StrokeShape="RoundRectangle 12">
                    <Entry
                        Keyboard="Telephone"
                        Placeholder="Mobile Number"
                        PlaceholderColor="#64748B"
                        Text="{Binding Mobile}"
                        TextColor="White"
                        VerticalOptions="Center" />
                </Border>

                <Border
                    Padding="15,0"
                    BackgroundColor="#0F172A"
                    HeightRequest="50"
                    Stroke="#15FFFFFF"
                    StrokeShape="RoundRectangle 12">
                    <Entry
                        IsPassword="True"
                        Placeholder="Password"
                        PlaceholderColor="#64748B"
                        Text="{Binding Password}"
                        TextColor="White"
                        VerticalOptions="Center" />
                </Border>

                <Label
                    FontAttributes="Bold"
                    FontSize="12"
                    HorizontalOptions="Center"
                    HorizontalTextAlignment="Center"
                    IsVisible="{Binding SignUpMessageVisible}"
                    Text="{Binding ErrorMessage}"
                    TextColor="#EF4444" />

                <VerticalStackLayout Margin="0,10,0,0" Spacing="10">
                    <Button
                        BackgroundColor="#1E3A8A"
                        CharacterSpacing="1"
                        Command="{Binding SignUpCommand}"
                        CornerRadius="12"
                        FontAttributes="Bold"
                        FontSize="14"
                        HeightRequest="52"
                        Text="SIGN UP"
                        TextColor="White" />

                    <Button
                        BackgroundColor="Transparent"
                        Command="{Binding BackToLoginCommand}"
                        FontSize="13"
                        HorizontalOptions="Center"
                        Text="Already have an account? Login"
                        TextColor="#64748B" />
                </VerticalStackLayout>

                <ActivityIndicator
                    HorizontalOptions="Center"
                    IsRunning="{Binding IsBusy}"
                    IsVisible="{Binding IsBusy}"
                    Color="#1E3A8A" />

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>