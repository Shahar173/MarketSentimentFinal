<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MarketSentimentFinal.Views.SignUpPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:MarketSentimentFinal.ViewModels"
    Title="Create Account"
    x:DataType="vm:SignUpViewModel"
    BackgroundColor="#121212"
    NavigationPage.HasNavigationBar="False"
    Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout
            Padding="30"
            Spacing="15"
            VerticalOptions="Center">

            <Label
                FontAttributes="Bold"
                FontSize="32"
                HorizontalOptions="Center"
                Text="New Account"
                TextColor="#512BD4" />

            <Label
                Margin="0,0,0,15"
                HorizontalOptions="Center"
                Text="Join our trading community"
                TextColor="Gray" />

            <Border
                Padding="10,0"
                BackgroundColor="#1E1E1E"
                HeightRequest="50"
                StrokeShape="RoundRectangle 10"
                StrokeThickness="0">
                <Entry
                    Placeholder="First Name"
                    PlaceholderColor="Gray"
                    Text="{Binding FirstName}"
                    TextColor="White"
                    VerticalOptions="Center" />
            </Border>

            <Border
                Padding="10,0"
                BackgroundColor="#1E1E1E"
                HeightRequest="50"
                StrokeShape="RoundRectangle 10"
                StrokeThickness="0">
                <Entry
                    Placeholder="Last Name"
                    PlaceholderColor="Gray"
                    Text="{Binding LastName}"
                    TextColor="White"
                    VerticalOptions="Center" />
            </Border>

            <Border
                Padding="10,0"
                BackgroundColor="#1E1E1E"
                HeightRequest="50"
                StrokeShape="RoundRectangle 10"
                StrokeThickness="0">
                <Entry
                    Keyboard="Email"
                    Placeholder="Email Address"
                    PlaceholderColor="Gray"
                    Text="{Binding Email}"
                    TextColor="White"
                    VerticalOptions="Center" />
            </Border>

            <Border
                Padding="10,0"
                BackgroundColor="#1E1E1E"
                HeightRequest="50"
                StrokeShape="RoundRectangle 10"
                StrokeThickness="0">
                <Entry
                    Keyboard="Telephone"
                    Placeholder="Mobile Number"
                    PlaceholderColor="Gray"
                    Text="{Binding Mobile}"
                    TextColor="White"
                    VerticalOptions="Center" />
            </Border>

            <Border
                Padding="10,0"
                BackgroundColor="#1E1E1E"
                HeightRequest="50"
                StrokeShape="RoundRectangle 10"
                StrokeThickness="0">
                <Entry
                    IsPassword="True"
                    Placeholder="Password"
                    PlaceholderColor="Gray"
                    Text="{Binding Password}"
                    TextColor="White"
                    VerticalOptions="Center" />
            </Border>

            <Button
                Margin="0,15,0,0"
                BackgroundColor="#512BD4"
                Command="{Binding SignUpCommand}"
                CornerRadius="10"
                FontAttributes="Bold"
                HeightRequest="55"
                Text="Sign Up"
                TextColor="White" />
            <Label
                HorizontalOptions="Center"
                HorizontalTextAlignment="Center"
                IsVisible="{Binding SignUpMessageVisible}"
                Text="{Binding ErrorMessage}"
                TextColor="#FF8A80" />

            <Button
                BackgroundColor="Transparent"
                Command="{Binding BackToLoginCommand}"
                HorizontalOptions="Center"
                Text="Already have an account? Login"
                TextColor="Gray" />

            <ActivityIndicator
                HorizontalOptions="Center"
                IsRunning="{Binding IsBusy}"
                IsVisible="{Binding IsBusy}"
                Color="#512BD4" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>