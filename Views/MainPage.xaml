<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MarketSentimentFinal.Views.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Shell.NavBarIsVisible="True">

    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Offset="0.0" Color="#0F2027" />
            <GradientStop Offset="0.5" Color="#203A43" />
            <GradientStop Offset="1.0" Color="#2C5364" />
        </LinearGradientBrush>
    </ContentPage.Background>

    <ScrollView>
        <VerticalStackLayout Padding="20,0,20,30" Spacing="15">

            <Label
                Margin="5,15,0,10"
                FontAttributes="Bold"
                FontSize="26"
                HorizontalOptions="Start"
                Text="MARKET NEWS"
                TextColor="White" />

            <Border
                Padding="20"
                BackgroundColor="White"
                StrokeShape="RoundRectangle 15"
                StrokeThickness="0">
                <VerticalStackLayout Spacing="8">
                    <HorizontalStackLayout Spacing="10">
                        <Border
                            Padding="8,2"
                            BackgroundColor="#E8F5E9"
                            StrokeShape="RoundRectangle 5">
                            <Label
                                FontAttributes="Bold"
                                FontSize="10"
                                Text="BULLISH"
                                TextColor="#2E7D32" />
                        </Border>
                        <Label
                            FontSize="11"
                            Text="CRYPTO • 2m ago"
                            TextColor="#777777"
                            VerticalOptions="Center" />
                    </HorizontalStackLayout>
                    <Label
                        FontAttributes="Bold"
                        FontSize="18"
                        Text="Bitcoin Testing Key Resistance Levels"
                        TextColor="#1A1A1A" />
                    <Label
                        FontSize="13"
                        Text="Market analysts are watching the $72,000 mark closely as trade volume increases across major exchanges."
                        TextColor="#444444" />
                </VerticalStackLayout>
            </Border>

            <Border
                Padding="20"
                BackgroundColor="White"
                StrokeShape="RoundRectangle 15"
                StrokeThickness="0">
                <VerticalStackLayout Spacing="8">
                    <HorizontalStackLayout Spacing="10">
                        <Border
                            Padding="8,2"
                            BackgroundColor="#F5F5F5"
                            StrokeShape="RoundRectangle 5">
                            <Label
                                FontAttributes="Bold"
                                FontSize="10"
                                Text="NEUTRAL"
                                TextColor="#616161" />
                        </Border>
                        <Label
                            FontSize="11"
                            Text="GOLD • 15m ago"
                            TextColor="#777777"
                            VerticalOptions="Center" />
                    </HorizontalStackLayout>
                    <Label
                        FontAttributes="Bold"
                        FontSize="18"
                        Text="XAU/USD Price Consolidation"
                        TextColor="#1A1A1A" />
                    <Label
                        FontSize="13"
                        Text="Gold prices remain steady today as investors wait for the upcoming inflation data report later this week."
                        TextColor="#444444" />
                </VerticalStackLayout>
            </Border>

            <Border
                Padding="20"
                BackgroundColor="White"
                StrokeShape="RoundRectangle 15"
                StrokeThickness="0">
                <VerticalStackLayout Spacing="8">
                    <HorizontalStackLayout Spacing="10">
                        <Border
                            Padding="8,2"
                            BackgroundColor="#E8F5E9"
                            StrokeShape="RoundRectangle 5">
                            <Label
                                FontAttributes="Bold"
                                FontSize="10"
                                Text="BULLISH"
                                TextColor="#2E7D32" />
                        </Border>
                        <Label
                            FontSize="11"
                            Text="STOCKS • 1h ago"
                            TextColor="#777777"
                            VerticalOptions="Center" />
                    </HorizontalStackLayout>
                    <Label
                        FontAttributes="Bold"
                        FontSize="18"
                        Text="Tech Giants Rally on AI Expectations"
                        TextColor="#1A1A1A" />
                    <Label
                        FontSize="13"
                        Text="Major technology stocks see significant gains as new AI integration plans are announced by industry leaders."
                        TextColor="#444444" />
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>