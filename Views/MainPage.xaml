<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MarketSentimentFinal.Views.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:components="clr-namespace:MarketSentimentFinal.Views.Components"
    xmlns:vm="clr-namespace:MarketSentimentFinal.ViewModels"
    x:DataType="vm:MainPageViewModel"
    ClassId="MainPage"
    Shell.NavBarIsVisible="False">

    <Grid BackgroundColor="#05070A">
        <BoxView
            CornerRadius="200"
            HeightRequest="400"
            HorizontalOptions="End"
            TranslationX="150"
            TranslationY="-150"
            VerticalOptions="Start"
            WidthRequest="400">
            <BoxView.Background>
                <RadialGradientBrush>
                    <GradientStop Offset="0.0" Color="#1E3A8A" />
                    <GradientStop Offset="1.0" Color="Transparent" />
                </RadialGradientBrush>
            </BoxView.Background>
        </BoxView>

        <BoxView
            CornerRadius="200"
            HeightRequest="400"
            HorizontalOptions="Start"
            TranslationX="-150"
            TranslationY="150"
            VerticalOptions="End"
            WidthRequest="400">
            <BoxView.Background>
                <RadialGradientBrush>
                    <GradientStop Offset="0.0" Color="#1E3A8A" />
                    <GradientStop Offset="1.0" Color="Transparent" />
                </RadialGradientBrush>
            </BoxView.Background>
        </BoxView>

        <Grid
            Padding="20,15,20,0"
            RowDefinitions="Auto, Auto, Auto, Auto, Auto, *"
            RowSpacing="12">

            <Image
                Grid.Row="0"
                HeightRequest="40"
                HorizontalOptions="Center"
                Source="market_mood_logo.png"
                WidthRequest="40">
                <Image.Clip>
                    <EllipseGeometry
                        Center="20,20"
                        RadiusX="20"
                        RadiusY="20" />
                </Image.Clip>
            </Image>

            <VerticalStackLayout
                Grid.Row="1"
                HorizontalOptions="Center"
                Spacing="0">
                <Label
                    FontAttributes="Bold"
                    FontSize="45"
                    Text="{Binding MoodScore}"
                    TextColor="#00E676" />
                <Label
                    FontAttributes="Bold"
                    FontSize="11"
                    HorizontalOptions="Center"
                    Text="{Binding MoodStatusText}"
                    TextColor="#00E676" />
            </VerticalStackLayout>

            <VerticalStackLayout
                Grid.Row="2"
                Margin="20,0"
                Spacing="0">
                <BoxView CornerRadius="4" HeightRequest="8">
                    <BoxView.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Offset="0.0" Color="#EF4444" />
                            <GradientStop Offset="0.5" Color="#EAB308" />
                            <GradientStop Offset="1.0" Color="#22C55E" />
                        </LinearGradientBrush>
                    </BoxView.Background>
                </BoxView>
                <Ellipse
                    Margin="0,-10,0,0"
                    Fill="White"
                    HeightRequest="12"
                    HorizontalOptions="Start"
                    TranslationX="{Binding IndicatorPosition}"
                    WidthRequest="12" />
            </VerticalStackLayout>

            <Grid
                Grid.Row="3"
                ColumnDefinitions="*, *, *"
                ColumnSpacing="8"
                HeightRequest="45">
                <Border
                    Grid.Column="0"
                    BackgroundColor="#08FFFFFF"
                    Stroke="#22FFFFFF"
                    StrokeShape="RoundRectangle 8">
                    <VerticalStackLayout VerticalOptions="Center">
                        <Label
                            FontSize="6"
                            HorizontalOptions="Center"
                            Text="BUY"
                            TextColor="#94A3B8" />
                        <Label
                            FontAttributes="Bold"
                            FontSize="12"
                            HorizontalOptions="Center"
                            Text="{Binding WhaleBuyPercent}"
                            TextColor="#22C55E" />
                    </VerticalStackLayout>
                </Border>
                <Border
                    Grid.Column="1"
                    BackgroundColor="#08FFFFFF"
                    Stroke="#22FFFFFF"
                    StrokeShape="RoundRectangle 8">
                    <VerticalStackLayout VerticalOptions="Center">
                        <Label
                            FontSize="6"
                            HorizontalOptions="Center"
                            Text="SELL"
                            TextColor="#94A3B8" />
                        <Label
                            FontAttributes="Bold"
                            FontSize="12"
                            HorizontalOptions="Center"
                            Text="{Binding WhaleSellPercent}"
                            TextColor="#EF4444" />
                    </VerticalStackLayout>
                </Border>
                <Border
                    Grid.Column="2"
                    BackgroundColor="#08FFFFFF"
                    Stroke="#22FFFFFF"
                    StrokeShape="RoundRectangle 8">
                    <VerticalStackLayout VerticalOptions="Center">
                        <Label
                            FontSize="6"
                            HorizontalOptions="Center"
                            Text="F&amp;G"
                            TextColor="#94A3B8" />
                        <Label
                            FontAttributes="Bold"
                            FontSize="12"
                            HorizontalOptions="Center"
                            Text="{Binding FearGreedValue}"
                            TextColor="#EAB308" />
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <Grid
                Grid.Row="4"
                Margin="0,30,0,0"
                ColumnDefinitions="*, *"
                ColumnSpacing="8"
                RowDefinitions="*, *"
                RowSpacing="8"
                VerticalOptions="Start">
                <Border
                    Grid.Row="0"
                    Grid.Column="0"
                    Padding="10"
                    BackgroundColor="#08FFFFFF"
                    HeightRequest="85"
                    Stroke="#22FFFFFF"
                    StrokeShape="RoundRectangle 10">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoToChatAssistantCommand}" />
                    </Border.GestureRecognizers>
                    <VerticalStackLayout VerticalOptions="Center">
                        <Label
                            FontAttributes="Bold"
                            FontSize="13"
                            Text="💬 Chat"
                            TextColor="White" />
                        <Label
                            FontSize="9"
                            Text="AI Analyst"
                            TextColor="#94A3B8" />
                    </VerticalStackLayout>
                </Border>
                <Border
                    Grid.Row="0"
                    Grid.Column="1"
                    Padding="10"
                    BackgroundColor="#08FFFFFF"
                    HeightRequest="85"
                    Stroke="#22FFFFFF"
                    StrokeShape="RoundRectangle 10">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoToWhaleTrackerCommand}" />
                    </Border.GestureRecognizers>
                    <VerticalStackLayout VerticalOptions="Center">
                        <Label
                            FontAttributes="Bold"
                            FontSize="13"
                            Text="🐋 Whales"
                            TextColor="White" />
                        <Label
                            FontSize="9"
                            Text="Live Data"
                            TextColor="#94A3B8" />
                    </VerticalStackLayout>
                </Border>
                <Border
                    Grid.Row="1"
                    Grid.Column="0"
                    Margin="0,15,0,0"
                    Padding="10"
                    BackgroundColor="#08FFFFFF"
                    HeightRequest="85"
                    Stroke="#22FFFFFF"
                    StrokeShape="RoundRectangle 10">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoToFearAndGreedCommand}" />
                    </Border.GestureRecognizers>
                    <VerticalStackLayout VerticalOptions="Center">
                        <Label
                            FontAttributes="Bold"
                            FontSize="13"
                            Text="⏱️ F&amp;G"
                            TextColor="White" />
                        <Label
                            FontSize="9"
                            Text="{Binding FearGreedStatus}"
                            TextColor="{Binding FearGreedColor}" />
                    </VerticalStackLayout>
                </Border>
                <Border
                    Grid.Row="1"
                    Grid.Column="1"
                    Margin="0,15,0,0"
                    Padding="10"
                    BackgroundColor="#08FFFFFF"
                    HeightRequest="85"
                    Stroke="#22FFFFFF"
                    StrokeShape="RoundRectangle 10">
                    <VerticalStackLayout Spacing="0" VerticalOptions="Center">
                        <Label
                            FontAttributes="Bold"
                            FontSize="13"
                            Text="🔥 Movers"
                            TextColor="White" />
                        <HorizontalStackLayout Spacing="4">
                            <Label
                                FontSize="9"
                                Text="BTC"
                                TextColor="#60A5FA" />
                            <Label
                                FontSize="9"
                                Text="+2.4%"
                                TextColor="#22C55E" />
                        </HorizontalStackLayout>
                        <HorizontalStackLayout Spacing="4">
                            <Label
                                FontSize="9"
                                Text="ETH"
                                TextColor="#60A5FA" />
                            <Label
                                FontSize="9"
                                Text="-1.1%"
                                TextColor="#EF4444" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <components:FloatingNavBar
                Grid.Row="5"
                Margin="0,0,0,10"
                VerticalOptions="End" />
        </Grid>
    </Grid>
</ContentPage>