<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MarketSentimentFinal.Views.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    ClassId="MainPage"
    Shell.NavBarIsVisible="True">

    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Offset="0.0" Color="#0F2027" />
            <GradientStop Offset="0.5" Color="#203A43" />
            <GradientStop Offset="1.0" Color="#2C5364" />
        </LinearGradientBrush>
    </ContentPage.Background>

    <ScrollView>
        <VerticalStackLayout Padding="25,30" Spacing="25">

            <VerticalStackLayout Spacing="4">
                <Label
                    FontAttributes="Bold"
                    FontSize="28"
                    HorizontalOptions="Center"
                    Text="Market mood"
                    TextColor="White" />
                <Label
                    FontSize="14"
                    HorizontalOptions="Center"
                    Text="Select an analytics route to evaluate the market state"
                    TextColor="#B0BEC5" />
            </VerticalStackLayout>

            <Grid>
                <Border
                    BackgroundColor="#1Affffff"
                    Stroke="#3300B4DB"
                    StrokeShape="RoundRectangle 15"
                    StrokeThickness="1">
                    <Border.Shadow>
                        <Shadow
                            Brush="#00B4DB"
                            Opacity="0.4"
                            Radius="8"
                            Offset="0,0" />
                    </Border.Shadow>
                    <Grid BackgroundColor="Transparent" MinimumHeightRequest="100" />
                </Border>
                <Grid
                    Padding="20"
                    ColumnDefinitions="*, Auto"
                    VerticalOptions="Center">
                    <VerticalStackLayout
                        Grid.Column="0"
                        Spacing="4"
                        VerticalOptions="Center">
                        <Label
                            FontAttributes="Bold"
                            FontSize="16"
                            Text="📰 News list"
                            TextColor="White" />
                        <Label
                            FontSize="12"
                            Text="Evaluate real-time incoming ecosystem intelligence feeds."
                            TextColor="#CFD8DC" />
                    </VerticalStackLayout>
                    <Button
                        Grid.Column="1"
                        BackgroundColor="#00B4DB"
                        Command="{Binding GoToNewsCommand}"
                        CornerRadius="8"
                        FontAttributes="Bold"
                        HeightRequest="40"
                        Text="Open"
                        TextColor="White"
                        WidthRequest="80" />
                </Grid>
            </Grid>

            <Grid>
                <Border
                    BackgroundColor="#1Affffff"
                    Stroke="#3300B4DB"
                    StrokeShape="RoundRectangle 15"
                    StrokeThickness="1">
                    <Border.Shadow>
                        <Shadow
                            Brush="#00B4DB"
                            Opacity="0.4"
                            Radius="8"
                            Offset="0,0" />
                    </Border.Shadow>
                    <Grid BackgroundColor="Transparent" MinimumHeightRequest="100" />
                </Border>
                <Grid
                    Padding="20"
                    ColumnDefinitions="*, Auto"
                    VerticalOptions="Center">
                    <VerticalStackLayout
                        Grid.Column="0"
                        Spacing="4"
                        VerticalOptions="Center">
                        <Label
                            FontAttributes="Bold"
                            FontSize="16"
                            Text="📊 Sentiment diagnostics"
                            TextColor="White" />
                        <Label
                            FontSize="12"
                            Text="View general market metrics and active momentum directions."
                            TextColor="#CFD8DC" />
                    </VerticalStackLayout>
                    <Button
                        Grid.Column="1"
                        BackgroundColor="#00B4DB"
                        Command="{Binding GoToSentimentDetailsCommand}"
                        CornerRadius="8"
                        FontAttributes="Bold"
                        HeightRequest="40"
                        Text="Open"
                        TextColor="White"
                        WidthRequest="80" />
                </Grid>
            </Grid>

            <Grid>
                <Border
                    BackgroundColor="#1Affffff"
                    Stroke="#3300B4DB"
                    StrokeShape="RoundRectangle 15"
                    StrokeThickness="1">
                    <Border.Shadow>
                        <Shadow
                            Brush="#00B4DB"
                            Opacity="0.4"
                            Radius="8"
                            Offset="0,0" />
                    </Border.Shadow>
                    <Grid BackgroundColor="Transparent" MinimumHeightRequest="100" />
                </Border>
                <Grid
                    Padding="20"
                    ColumnDefinitions="*, Auto"
                    VerticalOptions="Center">
                    <VerticalStackLayout
                        Grid.Column="0"
                        Spacing="4"
                        VerticalOptions="Center">
                        <Label
                            FontAttributes="Bold"
                            FontSize="16"
                            Text="📈 Fear &amp; greed history"
                            TextColor="White" />
                        <Label
                            FontSize="12"
                            Text="Track historical timelines and valuation cycles parameters."
                            TextColor="#CFD8DC" />
                    </VerticalStackLayout>
                    <Button
                        Grid.Column="1"
                        BackgroundColor="#00B4DB"
                        Command="{Binding GoToFearAndGreedCommand}"
                        CornerRadius="8"
                        FontAttributes="Bold"
                        HeightRequest="40"
                        Text="Open"
                        TextColor="White"
                        WidthRequest="80" />
                </Grid>
            </Grid>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>